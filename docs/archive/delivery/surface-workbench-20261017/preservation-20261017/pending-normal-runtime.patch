+/** Installed Pixi graph, current Simulation and SI core are real. Only Application
+ * (browser/GPU boundary), document, window and resize observation are substituted.
+ * These tests cannot certify browser pixels, GPU resources or native E2E behavior. */
+vi.mock('pixi.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof Pixi>();
+  const applications: Application[] = [];
+  class Application {
+    stage = new actual.Container();
+    canvas = Object.assign(new EventTarget(), {
+      width: 1,
+      height: 1,
+      dataset: {} as Record<string, string>,
+      style: { width: '', height: '', display: '' },
+      setAttribute() {},
+    });
+    callback?: (ticker: { elapsedMS: number }) => void;
+    ticker = { started: false, add: (callback: (ticker: { elapsedMS: number }) => void) => { this.callback = callback; } };
+    renderer: {
+      resolution: number;
+      resize(width: number, height: number, resolution?: number): void;
+    } = {
+      resolution: 1,
+      resize: (width: number, height: number, resolution = this.renderer.resolution) => {
+        this.renderer.resolution = resolution;
+        this.canvas.width = Math.round(width * resolution);
+        this.canvas.height = Math.round(height * resolution);
+      },
+    };
+    renderCalls = 0;
+    rendererDestroyOptions?: Pixi.RendererDestroyOptions;
+    constructor() {
+      applications.push(this);
+    }
+    init(options: { width: number; height: number; resolution: number }) {
+      this.renderer.resize(options.width, options.height, options.resolution);
+      return Promise.resolve();
+    }
+    start() {
+      this.ticker.started = true;
+    }
+    stop() {
+      this.ticker.started = false;
+    }
+    render() {
+      this.renderCalls++;
+    }
+    destroy(rendererOptions: Pixi.RendererDestroyOptions, stageOptions: Pixi.DestroyOptions) {
+      this.rendererDestroyOptions = rendererOptions;
+      this.stop();
+      this.stage.destroy(stageOptions);
+    }
+  }
+  return { ...actual, Application, applications };
+});
+
+
+interface ApplicationHarness {
+  stage: Pixi.Container;
+  canvas: EventTarget & { dataset: Record<string, string> };
+  ticker: { started: boolean };
+  callback?: (ticker: { elapsedMS: number }) => void;
+}
+const applications = (Pixi as unknown as { applications: ApplicationHarness[] }).applications;
+const documentState = Object.assign(new EventTarget(), { hidden: false });
