+      s.timeRevision=time.revision;advancePhysicalSurface(r,time.seconds/args.physical.speed,args.physical,data);
+      if(r.error){cancelSurfaceInteraction(s.controller);s.status='error';s.reason=r.error;event(s,'error',r.error);}
+    }
+  }
