+}
+export function yardRuntimeDiagnostics(s:YardRuntimeSession,assetIds:readonly string[]=[]):YardRuntimeDiagnostics {
+  const r=s.active?.runtime;
+  return {runtimeId:s.runtimeId,actorId:s.selection!==undefined?s.selection.actorId:s.controller?.status.actorId??null,
+    targetObjectId:s.selection!==undefined?s.selection.targetObjectId:s.active?.objectId??null,
+    ledgerId:r?`${s.runtimeId}/${s.active!.objectId}/${r.generation}`:null,status:s.status,reason:s.reason,
+    activeTick:r?.state?.tick??0,pendingSeconds:r?r.clock.pendingTicks*r.clock.dtSeconds+r.clock.remainderSeconds:0,
+    interaction:s.controller?{...s.controller.status}:null,
+    assetIds:[...new Set(assetIds)].slice(0,128),actors:[...s.simulation.actors.values()].slice(0,128).map(a=>({id:a.id,speciesId:a.speciesId,artworkId:a.artworkId??null})),
+    objects:s.simulation.scene.objects.map(o=>({id:o.id,kind:o.kind})),
+    bankedLedgers:[...s.ledgers.values()].map(l=>({objectId:l.objectId,ledgerId:`${s.runtimeId}/${l.objectId}/${l.runtime.generation}`,tick:l.runtime.state?.tick??0,
+      waterM3:l.runtime.state?.stores.reduce((sum,v)=>sum+v.liquidM3+v.snowWaterEquivalentM3,0)??0,canceledDebtSeconds:l.runtime.canceledDebtSeconds,
+      active:l===s.active,present:Boolean(geometry(s,l.objectId))})),eventTrace:s.trace.map(e=>({...e}))};
+}
+export function holdYardRuntime(s:YardRuntimeSession):void {
+  if(s.disposed)return;clearController(s);if(s.active)retirePhysicalSurfaceDebt(s.active.runtime);s.status='off';s.reason=null;
+}
+export function disposeYardRuntime(s:YardRuntimeSession):void {
+  if(s.disposed)return;clearController(s);for(const l of s.ledgers.values())retirePhysicalSurfaceDebt(l.runtime);
+  s.disposed=true;s.status='disposed';s.reason=null;event(s,'dispose','Renderer-owned runtime disposed; active claims released.');
+}
