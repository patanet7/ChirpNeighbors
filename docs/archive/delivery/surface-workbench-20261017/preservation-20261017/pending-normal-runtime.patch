+import { z } from "zod";
+import { yardReadResponseSchema } from "./contracts";
+import {
+  AnimationRegistry,
+  type AssetEntry,
+  type ResolvedAsset,
+} from "../assets/registry";
+import type { AnimationPin } from "../assets/manifest";
+import type { CatalogPin } from "../assets/catalog-pin";
+import { idSchema, timestampSchema } from "../domain/primitives";
+import type { YardSnapshot } from "../domain/yard";
+import type { SceneBird } from "../engine/types";
+
+export const yardRuntimeSelectionSchema = z
+  .object({
+    actorId: idSchema.nullable(),
+    targetObjectId: idSchema.nullable(),
+  })
+  .strict();
+/** Local selection only. Explicit null or a now-missing ID never means select a replacement. */
+export type YardRuntimeConfigSelection = z.infer<
+  typeof yardRuntimeSelectionSchema
+>;
+export interface YardRenderingIdentity {
+  birdId: string;
+  speciesId: string;
+  artworkId: string | null;
+  savedAnimationPin: AnimationPin | null;
+  savedCatalogPin: CatalogPin | null;
+  assetStatus: ResolvedAsset["status"];
+  catalogStatus: AssetEntry["catalogStatus"] | null;
+  renderedSchemaVersion: ResolvedAsset["manifest"]["schemaVersion"];
+  fixtureFallback: boolean;
+  resolvedAssetKey: string;
+}
+function checkedTime(now: number | string): number {
+  if (typeof now === "string") return Date.parse(timestampSchema.parse(now));
+  if (!Number.isFinite(now) || !Number.isFinite(new Date(now).valueOf()))
+    throw new Error("A valid explicit yard clock is required.");
+  return now;
+}
+/** One pure saved-state projection for normal yard and lab. The authenticated server already owns
+ * this snapshot: accept only its checked selected asset/pin aggregate. No repository, providers,
+ * observation synthesis, catalogue expansion, or new physical footprint authority exists here.
+ * The caller stores the first returned selection once per owner, then passes it on every refresh.
+ */
+export function buildYardRuntimeConfig(
+  snapshot: YardSnapshot,
+  assets: readonly AssetEntry[],
+  now: number | string,
+  selection?: YardRuntimeConfigSelection,
+) {
+  const at = checkedTime(now);
+  const current = yardReadResponseSchema.parse({ snapshot, assets });
+  const activeBirds = current.snapshot.birds.filter(
+    (bird) =>
+      bird.lifecycle === "permanent" ||
+      (bird.lifecycle === "temporary" && Date.parse(bird.expiresAt ?? "") > at),
+  );
+  const species = new Map(current.snapshot.species.map((row) => [row.id, row]));
+  const sceneBirds: SceneBird[] = activeBirds.map((bird) => ({
+    id: bird.id,
+    speciesId: bird.speciesId,
+    artworkId: bird.artworkId,
+    name: bird.name || species.get(bird.speciesId)?.commonName,
+  }));
+  const objects = current.snapshot.environment.objects;
+  const selected =
+    selection === undefined
+      ? {
+          actorId:
+            [...activeBirds].sort((a, b) =>
+              a.id < b.id ? -1 : a.id > b.id ? 1 : 0,
+            )[0]?.id ?? null,
+          targetObjectId:
+            objects
+              .filter((object) => object.kind === "bath")
+              .map((object) => object.id)
+              .sort()[0] ?? null,
+        }
+      : yardRuntimeSelectionSchema.parse(selection);
+  const actor =
+    selected.actorId === null
+      ? "none"
+      : activeBirds.some((bird) => bird.id === selected.actorId)
+        ? "available"
+        : "missing";
+  const target =
+    selected.targetObjectId === null
+      ? "none"
+      : objects.some(
+            (object) =>
+              object.kind === "bath" && object.id === selected.targetObjectId,
+          )
+        ? "available"
+        : "missing";
+  const registry = new AnimationRegistry();
+  registry.replace(current.assets);
+  const renderingIdentities: YardRenderingIdentity[] = sceneBirds.map(
+    (bird) => {
+      const resolved = registry.resolve(bird);
+      const artwork = current.snapshot.artworks.find(
+        (row) => row.id === bird.artworkId,
+      );
+      const asset = current.assets.find(
+        (row) => row.artworkId === bird.artworkId,
+      );
+      return {
+        birdId: bird.id,
+        speciesId: bird.speciesId,
+        artworkId: bird.artworkId ?? null,
+        savedAnimationPin: artwork?.animationPin ?? null,
+        savedCatalogPin: artwork?.catalogPin ?? null,
+        assetStatus: resolved.status,
+        catalogStatus: asset?.catalogStatus ?? null,
+        renderedSchemaVersion: resolved.manifest.schemaVersion,
+        fixtureFallback: resolved.status !== "ready",
+        resolvedAssetKey: resolved.key,
+      };
+    },
+  );
+  return {
+    asOf: new Date(at).toISOString(),
+    activeBirds,
+    sceneBirds,
+    assets: current.assets,
+    objects,
+    palette: current.snapshot.preferences.palette,
+    setting: current.snapshot.preferences.scene,
+    scenePin: current.snapshot.preferences.scenePin,
+    reducedMotion: current.snapshot.preferences.reducedMotion,
+    selection: selected,
+    selectionStatus: {
+      actor,
+      target,
+      ready: actor === "available" && target === "available",
+    },
+    renderingIdentities,
+  };
+}
+export type YardRuntimeConfig = ReturnType<typeof buildYardRuntimeConfig>;
