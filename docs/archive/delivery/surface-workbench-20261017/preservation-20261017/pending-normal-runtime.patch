+  const data=input(s,flags),step=updateSurfaceInteractions(s.controller,physicalBathStatus(s.active.runtime),0);
+  queuePhysicalSurfaceContacts(s.active.runtime,data,step.contacts);recordInteraction(s);
+}
+export function advanceYardRuntime(s:YardRuntimeSession,args:YardRuntimeAdvance):ReturnType<typeof samplePhysicalSurface>|undefined {
+  if(s.disposed)return;
+  const ready=prepare(s,args.physical),r=s.active?.runtime;if(!r)return;
+  const held=!ready||Boolean(args.paused||args.hidden||args.reducedMotion),data=input(s,{...args,paused:held});
+  advancePhysicalSurface(r,args.delta,args.physical,data);
+  if(r.error){if(s.controller)cancelSurfaceInteraction(s.controller);s.status='error';if(s.reason!==r.error)event(s,'error',r.error);s.reason=r.error;}
+  else if(ready){s.status=held?'held':'active';s.reason=held?'Time held; stored mass and inactive ledgers retained.':null;}
+  if(!held&&!r.error&&s.controller){
+    settleYardRuntime(s,args);
+    const request=args.interactionRequest;
+    if(request&&Number.isSafeInteger(request.revision)&&request.revision>=0&&request.revision!==s.interactionRevision){s.interactionRevision=request.revision;
+      if(request.action==='cancel')cancelSurfaceInteraction(s.controller);else requestSurfaceInteraction(s.controller,request.action==='drinking'?'drink':'bath');recordInteraction(s);}
