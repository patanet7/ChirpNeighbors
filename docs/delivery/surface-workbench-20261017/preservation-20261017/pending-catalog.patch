+    if (claim && typeof claim === "object")
+      for (const key of ["regionIds", "habitatIds", "windows", "sources"]) {
+        const a = (claim as Record<string, unknown>)[key];
+        if (!Array.isArray(a) || a.length > 8)
+          throw new Error("Claim references exceed bounded admission.");
+      }
+  }
+  return freeze(occurrenceDatasetSchema.parse(value));
+}
+/** No proposal prose is converted into invented dates, probabilities or live presence. */
+export function unconfiguredOccurrenceDataset(): OccurrenceDataset {
+  return parseOccurrenceDataset({
+    schemaVersion: 1,
+    id: "chirp-occurrence-claims",
+    version: "1",
+    readiness: "unconfigured",
+    regions: [],
+    habitats: [],
+    claims: [],
+  });
+}
+function localDateAt(at: string, timeZone: string): string {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(new Date(at));
+  const get = (k: string) => parts.find((p) => p.type === k)?.value ?? "";
+  return `${get("year")}-${get("month")}-${get("day")}`;
+}
+function inWindow(day: string, w: z.infer<typeof annualWindowSchema>): boolean {
+  return w.from <= w.through
+    ? day >= w.from && day <= w.through
+    : day >= w.from || day <= w.through;
+}
+/** Read-only qualitative source claims, never actual observations or a live-presence assertion. */
+export function queryLikelySpecies(
+  value: unknown,
+  input: unknown,
+): OccurrenceResult {
+  if (!input || typeof input !== "object")
+    throw new Error("Occurrence query must be an object.");
+  for (const key of ["regionIds", "habitatIds"]) {
+    const a = (input as Record<string, unknown>)[key];
+    if (!Array.isArray(a) || a.length > 8)
+      throw new Error("Occurrence query exceeds bounded admission.");
+  }
+  const d = parseOccurrenceDataset(value),
+    q = occurrenceQuerySchema.parse(input),
