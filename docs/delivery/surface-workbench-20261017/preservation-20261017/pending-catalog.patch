+    </p>
+    {#if data.reuse}<p class="fine">
+        {reuseFrames.length} frame references · {reuseClips.length} clip records under the species filter.
+        Pack filtering applies to coverage; this report has no declared pack association.
+      </p>
+      <div class="reuse-grid">
+        {#each reuseClips as clip (`${clip.id}:${clip.version}`)}<article class="coverage-row">
+            <div class="row-heading">
+              <h3>{clip.id} · v{clip.version}</h3>
+              <span class="badge" data-status={clip.status}>Compatibility: {clip.status}</span>
+            </div>
+            <p>
+              {clip.basis} · {clip.distinctRgbaFrames} distinct RGBA frames · {clip.durationTicks} ticks
+              at 30 Hz
+            </p>
+            <p class="fine">
+              Declared compatibility: {clip.compatible
+                ? 'compatible'
+                : 'not established / incompatible'} · clip review: {clip.reviewStatus} · approval inherited:
+              no.
+            </p>
+            {#if clip.issues.length}<details>
+                <summary>{clip.issues.length} compatibility or feedback issues</summary>
+                <ul>
+                  {#each clip.issues as issue, index (index)}<li>
+                      <b>{issue.code}</b>: {issue.detail}{issue.frameId
+                        ? ` (${issue.frameId})`
+                        : ''}
+                    </li>{/each}
+                </ul>
+              </details>{/if}
+          </article>{:else}<p class="empty">
+            No clip reuse declarations match this read model and species filter. No reuse approval
+            is inferred.
+          </p>{/each}
+      </div>
+      <details>
+        <summary>Individual frame eligibility · {reuseFrames.length} references</summary>
+        <ul>
+          {#each reuseFrames as frame (`${frame.ref.id}:${frame.ref.version}`)}<li>
+              <b>{frame.ref.id} · v{frame.ref.version}</b>: {frame.eligibleForProposal
+                ? 'eligible for a proposal'
+                : 'not established / blocked'}; structural {frame.structuralStatus}; frame review {frame.frameReview};
+              source clip review {frame.sourceClipReview}; rights {frame.rightsStatus}.{#if frame.issues.length}<ul
+                >
+                  {#each frame.issues as issue, index (index)}<li>
+                      {issue.code}: {issue.detail}
+                    </li>{/each}
+                </ul>{/if}
+            </li>{/each}
+        </ul>
+      </details>
+    {:else}<p class="notice">
+        No frame-reuse read model was supplied. Pixel equality, source rejection and reuse
+        eligibility have not been inferred.
+      </p>{/if}
+  </section>
+  <details class="panel">
+    <summary>Shared facts & exact identity joins · {selectedFacts.length} records</summary>
+    <p class="fine">
+      These are the same source-linked facts used by the garden learning panel. Source records stay
+      separate from the pinned native taxonomy unless the server supplies a reviewed exact alias.
+    </p>
+    {#each selectedFacts as entry (entry.key)}<article class="fact-row">
+        <h3>{entry.record.species.commonName} · <i>{entry.record.species.scientificName}</i></h3>
+        <p>
+          <span
+            class="badge"
+            data-status={entry.resolution?.status === 'mapped' ||
+            entry.resolution?.status === 'native'
+              ? 'accepted'
+              : 'unknown'}>{entry.resolution?.status ?? 'resolution not supplied'}</span
+          >
+          · source record {entry.record.id}
+        </p>
+        {#if entry.resolution?.reason}<p class="fine">{entry.resolution.reason}</p>{/if}
+        <p class="fine">
+          Regional status: {entry.record.regionalStatus}. Home presence: unconfirmed. Measurements
+          and artwork scale require their own review.
+        </p>
+        <dl>
+          {#each Object.entries(entry.record.fields) as [id, field] (id)}<div>
+              <dt>{id} · {field.status}</dt>
+              <dd>{field.text ?? 'No source-linked field supplied.'}</dd>
+            </div>{/each}
+        </dl>
+        <p class="fine">
+          {entry.record.funFacts.length} source-linked fun-fact entries; {entry.record.sources
+            .length} source records; {entry.record.sourceConflicts.length} unresolved measurement conflicts.
+        </p>
+      </article>{/each}
+  </details>
+</main>
