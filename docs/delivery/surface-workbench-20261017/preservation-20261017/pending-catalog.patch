+    reasons.push(
+      "Expired, not-yet-valid or future-checked claims were withheld; stale evidence is not absence.",
+    );
+  if (outsideSeason)
+    reasons.push(
+      "No matching annual window for some claims; outside-window data is not confirmed absence.",
+    );
