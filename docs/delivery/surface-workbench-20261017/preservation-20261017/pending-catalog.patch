+  if (!dev || env.CHIRP_DEV_AUTH !== "1")
+    error(404, "Development catalog review is unavailable.");
+  if (
+    locals.identity.mode !== "development" ||
+    !["dev:alice", "dev:bob"].includes(locals.identity.ownerId)
