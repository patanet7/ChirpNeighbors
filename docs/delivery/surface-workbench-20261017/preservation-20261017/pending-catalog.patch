+import { dev } from "$app/environment";
+import { env } from "$env/dynamic/private";
+import { error, json, type RequestHandler } from "@sveltejs/kit";
+import { requireOwner } from "$lib/server/http";
+import { getRuntime } from "$lib/server/runtime";
+import {
+  getCatalogReview,
+  parseCatalogReviewSearch,
+} from "$lib/server/catalog-review";
+import { CatalogReadError } from "$lib/server/catalog-read";
+import {
+  requestBudgets,
+  requestBudgetResponse,
+} from "$lib/server/operations/request-budget";
+
+/** Read-only GET uses the existing authenticated session. It accepts no owner or mutation fields. */
+export const GET: RequestHandler = async (event) => {
+  const owner = requireOwner(event);
+  if (!dev || env.CHIRP_DEV_AUTH !== "1")
+    error(404, "Development catalog review is unavailable.");
+  if (
+    event.locals.identity?.mode !== "development" ||
+    !["dev:alice", "dev:bob"].includes(owner)
+  )
+    error(403, "Choose a development test yard for catalog review.");
+  const now = new Date().toISOString();
+  try {
+    parseCatalogReviewSearch(event.url.searchParams, now);
+  } catch {
+    error(400, "Use a valid UTC evidence window and page query.");
+  }
+  const admission = requestBudgets.acquire("reads", owner);
+  if (!admission.accepted) return requestBudgetResponse(admission);
+  try {
+    return json(
+      await getCatalogReview(getRuntime(), owner, event.url.searchParams, now),
+      {
+        headers: {
+          "cache-control": "private, no-store",
+          "x-content-type-options": "nosniff",
+        },
+      },
+    );
+  } catch (cause) {
+    if (cause instanceof CatalogReadError)
+      error(cause.code === "STALE_REVISION" ? 409 : 400, cause.message);
+    error(503, "Catalog review is temporarily unavailable.");
+  } finally {
+    admission.release();
+  }
+};
