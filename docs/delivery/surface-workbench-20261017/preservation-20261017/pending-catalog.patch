+    reasons.push("No qualifying data; this does not mean absent.");
+  return freeze({
+    status:
+      d.readiness === "unconfigured"
+        ? "unconfigured"
+        : !rows.length || unknownRegionIds.length || unknownHabitatIds.length
+          ? "unknown"
+          : "ready",
+    localDate,
+    observed: false,
+    rows,
+    unknownRegionIds,
+    unknownHabitatIds,
+    reasons,
+  });
+}
