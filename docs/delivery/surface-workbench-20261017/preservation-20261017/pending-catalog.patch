+import { z } from "zod";
+import { animationPinSchema, animationStates } from "../assets/manifest-v2";
+import { catalogReleaseSchema } from "../assets/catalog-contracts";
+import { textureReviewReceiptSchema } from "../workbench/texture-profile";
+import { catalogIdSchema, taxonRefSchema, taxonIdentityKey } from "./identity";
+import {
+  ACTION_SLOTS,
+  actionSlotIdSchema,
+  requestedActionIds,
+  type RequestedActionId,
+} from "./slots";
+
+/** Read projection of explicit declarations. This module cannot admit, approve, pin or activate art. */
+export const COVERAGE_LIMITS = Object.freeze({
+  subjects: 64,
+  evidence: 2048,
+  referencesPerGate: 8,
+});
+export const coverageStatuses = [
+  "unknown",
+  "missing",
+  "candidate",
+  "accepted",
+  "rejected",
+  "not-applicable",
+  "conflicted",
+] as const;
+export const coverageStatusSchema = z.enum(coverageStatuses);
+export type CoverageStatus = z.infer<typeof coverageStatusSchema>;
+export const coverageGateIds = [
+  "sourcePresence",
+  "genuineFrames",
+  "structuralValidation",
+  "reviewApproval",
+  "rightsClearance",
+  "integration",
+  "runtime",
+  "nativeSupport",
+  "biologicalScale",
+  "facts",
+  "motionQuality",
+] as const;
+export type CoverageGateId = (typeof coverageGateIds)[number];
+const refs = z.array(catalogIdSchema).max(COVERAGE_LIMITS.referencesPerGate);
+export const coverageSourceBindingSchema = z
+  .object({
+    sourceDigest: z.string().regex(/^[a-f0-9]{64}$/),
+    receiptDigest: z.string().regex(/^[a-f0-9]{64}$/),
+  })
+  .strict();
+export const coverageSubjectSchema = z
+  .object({ taxon: taxonRefSchema, packId: catalogIdSchema })
+  .strict();
+export type CoverageSubject = z.infer<typeof coverageSubjectSchema>;
+export const coverageGateEvidenceSchema = z
+  .object({
+    status: coverageStatusSchema,
+    evidenceRefs: refs,
+    binding: coverageSourceBindingSchema.nullable(),
+  })
+  .strict();
+export type CoverageGateEvidence = z.infer<typeof coverageGateEvidenceSchema>;
+const optionalGate = coverageGateEvidenceSchema.optional();
+const gatesSchema = z
+  .object({
+    sourcePresence: optionalGate,
+    genuineFrames: optionalGate,
+    structuralValidation: optionalGate,
+    reviewApproval: optionalGate,
+    rightsClearance: optionalGate,
+    integration: optionalGate,
+    runtime: optionalGate,
+    nativeSupport: optionalGate,
+    biologicalScale: optionalGate,
+    facts: optionalGate,
+    motionQuality: optionalGate,
+  })
+  .strict();
+export const coverageOrganizationSchema = z
+  .object({
+    familyId: catalogIdSchema.nullable(),
+    variantId: catalogIdSchema.nullable(),
+    layer: z.enum(["background", "ground", "objects", "foreground"]).nullable(),
+    clipId: catalogIdSchema.nullable(),
+    state: z.enum(animationStates).nullable(),
+    reference: z
+      .discriminatedUnion("kind", [
+        z
+          .object({
+            kind: z.literal("catalog-release"),
+            release: catalogReleaseSchema,
+          })
+          .strict(),
+        z
+          .object({ kind: z.literal("animation-pin"), pin: animationPinSchema })
+          .strict(),
+        z
+          .object({
+            kind: z.literal("review-package"),
+            receipt: textureReviewReceiptSchema,
+          })
+          .strict(),
+      ])
+      .nullable(),
+  })
+  .strict();
+export const coverageEvidenceSchema = z
+  .object({
+    id: catalogIdSchema,
+    subject: coverageSubjectSchema,
+    slotId: actionSlotIdSchema,
+    sourceBinding: coverageSourceBindingSchema.nullable(),
+    frameCount: z.number().int().min(1).max(256).nullable(),
+    distinctFrameCount: z.number().int().min(1).max(256).nullable(),
+    animation: z.enum([
+      "static",
+      "genuine-frames",
+      "procedural-only",
+      "unknown",
+    ]),
+    gates: gatesSchema,
+    scale: z
+      .object({
+        endpointConvention: z.enum(["unknown", "source-defined", "conflicted"]),
+        fixedAcrossFrames: z.boolean().nullable(),
+        fixedAcrossClips: z.boolean().nullable(),
+        referenceId: catalogIdSchema.nullable(),
+      })
+      .strict()
+      .nullable(),
+    organization: coverageOrganizationSchema.optional(),
+    motionQuality: z
+      .object({
+        ordinaryGroundGait: coverageStatusSchema,
+        sourceMotion: z.enum([
+          "upright-small-steps",
+          "deep-crouch-launch",
+          "exaggerated-leg-reach",
+          "takeoff-startle",
+          "unknown",
+        ]),
+        evidenceRefs: refs,
+      })
+      .strict()
+      .optional(),
+  })
+  .strict()
+  .superRefine((value, ctx) => {
+    if (
+      value.distinctFrameCount !== null &&
+      (value.frameCount === null || value.distinctFrameCount > value.frameCount)
+    )
+      ctx.addIssue({
+        code: "custom",
+        message: "Distinct frame count cannot exceed the declared frame count.",
+      });
+  });
+export type CoverageEvidenceRecord = z.infer<typeof coverageEvidenceSchema>;
+export const coverageQuerySchema = z
+  .object({
+    subjects: z
+      .array(coverageSubjectSchema)
+      .min(1)
+      .max(COVERAGE_LIMITS.subjects),
+    requestedSlots: z
+      .array(actionSlotIdSchema)
+      .min(1)
+      .max(requestedActionIds.length)
+      .optional(),
+    evidence: z.array(coverageEvidenceSchema).max(COVERAGE_LIMITS.evidence),
+  })
+  .strict();
+export type CoverageQuery = z.infer<typeof coverageQuerySchema>;
+const gateResultSchema = z
+  .object({
+    status: coverageStatusSchema,
+    evidenceRefs: refs,
+    reason: z.string().min(1).max(500),
+  })
+  .strict();
+export type CoverageGateResult = z.infer<typeof gateResultSchema>;
+const completeGates = z
+  .object({
+    sourcePresence: gateResultSchema,
+    genuineFrames: gateResultSchema,
+    structuralValidation: gateResultSchema,
+    reviewApproval: gateResultSchema,
+    rightsClearance: gateResultSchema,
+    integration: gateResultSchema,
+    runtime: gateResultSchema,
+    nativeSupport: gateResultSchema,
+    biologicalScale: gateResultSchema,
+    facts: gateResultSchema,
+    motionQuality: gateResultSchema,
+  })
+  .strict();
+const rowSchema = z
+  .object({
+    subject: coverageSubjectSchema,
+    slotId: actionSlotIdSchema,
+    requested: z.literal(true),
+    status: coverageStatusSchema,
+    sourceCoverage: coverageStatusSchema,
+    fulfillsRequestedSlot: z.boolean(),
+    runtimeReady: z.boolean(),
+    evidenceIds: z.array(catalogIdSchema).max(COVERAGE_LIMITS.evidence),
+    sourceBinding: coverageSourceBindingSchema.nullable(),
+    organization: z
+      .array(coverageOrganizationSchema)
+      .max(COVERAGE_LIMITS.evidence),
+    gates: completeGates,
+    gaps: z.array(z.enum(coverageGateIds)).max(coverageGateIds.length),
+  })
+  .strict();
+export const coverageReportSchema = z
+  .object({
+    schemaVersion: z.literal(1),
+    authority: z.literal("informational-read-projection"),
+    rows: z
+      .array(rowSchema)
+      .max(COVERAGE_LIMITS.subjects * requestedActionIds.length),
+    counts: z
+      .object({
+        requested: z.number().int().nonnegative(),
+        fulfilled: z.number().int().nonnegative(),
+        runtimeReady: z.number().int().nonnegative(),
+        sourceCovered: z.number().int().nonnegative(),
+      })
+      .strict(),
+  })
+  .strict();
+export type CoverageReport = z.infer<typeof coverageReportSchema>;
+const sourceGates = new Set<CoverageGateId>([
+  "sourcePresence",
+  "genuineFrames",
+  "structuralValidation",
+  "reviewApproval",
+  "rightsClearance",
+  "integration",
+  "runtime",
+  "biologicalScale",
+  "motionQuality",
+]);
+const bindingKey = (value: CoverageEvidenceRecord["sourceBinding"]) =>
+  value ? JSON.stringify([value.sourceDigest, value.receiptDigest]) : null;
+const compare = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
+const subjectKey = (value: CoverageSubject) =>
+  JSON.stringify([
+    taxonIdentityKey(value.taxon),
+    value.taxon.scientificName,
+    value.packId,
+  ]);
+const unknown = (
+  reason = "No matching evidence was supplied.",
+): CoverageGateResult => ({ status: "unknown", evidenceRefs: [], reason });
+function result(
+  status: CoverageStatus,
+  evidenceRefs: string[],
+  reason: string,
+): CoverageGateResult {
+  const unique = [...new Set(evidenceRefs)].sort();
+  if (unique.length > COVERAGE_LIMITS.referencesPerGate)
+    throw new Error(
+      "Coverage gate references exceed the bounded envelope; narrow the evidence query.",
+    );
+  return { status, evidenceRefs: unique, reason };
+}
+function effectiveGate(
+  record: CoverageEvidenceRecord,
+  gate: CoverageGateId,
+  slot: (typeof ACTION_SLOTS)[number],
+): CoverageGateResult {
+  const claim = record.gates[gate];
+  if (gate === "nativeSupport" && slot.nativeState === null)
+    return result(
+      "not-applicable",
+      [],
+      "This requested action has no dedicated native state; a presentation wrapper does not add one.",
+    );
+  if (gate === "genuineFrames" && slot.mediaRequirement === "registered-pose")
+    return result(
+      "not-applicable",
+      [],
+      "This slot requests a registered pose; no animated coverage is inferred.",
+    );
+  const ordinary = slot.motionAcceptance === "ordinary-upright-walk-hop";
+  if (gate === "motionQuality" && !ordinary)
+    return result(
+      "not-applicable",
+      [],
+      "Ordinary ground-gait quality is not applicable to this action.",
+    );
+  if (
+    gate === "genuineFrames" &&
+    (record.animation === "static" ||
+      record.animation === "procedural-only" ||
+      record.frameCount === 1 ||
+      record.distinctFrameCount === 1)
+  )
+    return result(
+      "rejected",
+      claim?.evidenceRefs ?? [],
+      "An animated or distinct-pose slot cannot be fulfilled by one still or procedural movement of a still.",
+    );
+  if (
+    gate === "motionQuality" &&
+    ordinary &&
+    record.motionQuality &&
+    ["deep-crouch-launch", "exaggerated-leg-reach", "takeoff-startle"].includes(
+      record.motionQuality.sourceMotion,
+    )
+  )
+    return result(
+      "rejected",
+      record.motionQuality.evidenceRefs,
+      "Ordinary ground travel requires light upright short steps, pauses, modest bounce and foot lift; launch/startle exaggeration does not satisfy it.",
+    );
+  if (!claim) return unknown();
+  if (claim.status === "not-applicable")
+    return result(
+      "rejected",
+      claim.evidenceRefs,
+      "A required evidence gate cannot be bypassed as not applicable.",
+    );
+  if (claim.status !== "accepted")
+    return result(
+      claim.status,
+      claim.evidenceRefs,
+      "The supplied evidence retains its declared status.",
+    );
+  if (!claim.evidenceRefs.length)
+    return result(
+      "unknown",
+      [],
+      "Accepted evidence requires an explicit receipt or source reference.",
+    );
+  if (
+    sourceGates.has(gate) &&
+    (!record.sourceBinding ||
+      bindingKey(record.sourceBinding) !== bindingKey(claim.binding))
+  )
+    return result(
+      "rejected",
+      claim.evidenceRefs,
+      "Accepted source evidence must match this exact source and receipt binding.",
+    );
+  const reference = record.organization?.reference;
+  if (reference?.kind === "review-package") {
+    if (
+      record.sourceBinding?.sourceDigest !== reference.receipt.original.sha256
+    )
+      return result(
+        "rejected",
+        claim.evidenceRefs,
+        "The declared source binding differs from its reused review receipt.",
+      );
