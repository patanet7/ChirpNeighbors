+    habitatSet = new Set(d.habitats.map((h) => h.id));
+  const unknownRegionIds = q.regionIds
+      .filter((id) => !regionMap.has(id))
+      .sort(),
+    unknownHabitatIds = q.habitatIds.filter((id) => !habitatSet.has(id)).sort();
+  const reasons: string[] = [];
+  if (d.readiness === "unconfigured")
+    reasons.push(
+      "No reviewed occurrence claims are configured; proposal prose is not seasonal presence data.",
+    );
+  if (unknownRegionIds.length)
+    reasons.push("Unknown coarse regions are not absence.");
+  if (unknownHabitatIds.length)
+    reasons.push("Unknown habitats are not absence.");
+  const ancestors = new Set<string>();
+  function add(id: string) {
+    if (ancestors.has(id)) return;
+    ancestors.add(id);
+    for (const p of regionMap.get(id)?.parents ?? []) add(p);
+  }
+  q.regionIds.filter((id) => regionMap.has(id)).forEach(add);
+  const grouped = new Map<
+    string,
+    {
+      taxon: TaxonRef;
+      statuses: Set<"likely" | "possible" | "unlikely">;
+      claimIds: Set<string>;
+      sourceIds: Set<string>;
+    }
+  >();
+  let stale = 0,
+    outsideSeason = 0,
+    habitatUnspecified = 0;
+  for (const c of d.claims) {
+    if (!c.regionIds.some((id) => ancestors.has(id))) continue;
+    if (c.habitatIds.length && !q.habitatIds.length) {
+      habitatUnspecified++;
+      continue;
+    }
+    if (
+      c.habitatIds.length &&
+      !c.habitatIds.some((id) => q.habitatIds.includes(id))
+    )
+      continue;
+    // Validity bounds and source checks are interpreted on explicitly supplied as-of UTC date.
+    const asOfDate = q.asOf.slice(0, 10);
+    if (
+      asOfDate < c.validFrom ||
+      asOfDate > c.validThrough ||
+      c.sources.some((s) => s.checkedAt > asOfDate)
+    ) {
+      stale++;
+      continue;
+    }
+    if (!c.windows.some((w) => inWindow(localDate.slice(5), w))) {
+      outsideSeason++;
+      continue;
+    }
+    const key = taxonIdentityKey(c.taxon),
+      row = grouped.get(key) ?? {
+        taxon: c.taxon,
+        statuses: new Set(),
+        claimIds: new Set(),
+        sourceIds: new Set(),
+      };
+    row.statuses.add(c.support);
+    row.claimIds.add(c.id);
+    c.sources.forEach((s) => row.sourceIds.add(s.id));
+    grouped.set(key, row);
+  }
