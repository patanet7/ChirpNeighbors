+  } catch {
+    error(400, "Use a valid UTC evidence window and page query.");
+  }
+  const admission = requestBudgets.acquire("reads", locals.identity.ownerId);
+  if (!admission.accepted) error(429, "Catalog reads are busy. Please retry.");
+  try {
+    return await getCatalogReview(
+      getRuntime(),
+      locals.identity.ownerId,
+      url.searchParams,
+      now,
+    );
+  } catch (cause) {
+    if (cause instanceof CatalogReadError)
