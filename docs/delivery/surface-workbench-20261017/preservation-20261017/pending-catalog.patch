+import { z } from "zod";
+import { idSchema, timestampSchema } from "../domain/primitives";
+import { SPECIES_FACTS_CATALOG } from "../catalog/species-facts";
+import {
+  buildFactsAliasRegistry,
+  factRecordTaxonRef,
+  resolveTaxonIdentity,
+} from "../catalog/identity";
+import {
+  frameReuseCatalogSchema,
+  queryFrameReuse,
+  type FrameReuseCatalog,
+  type FrameReuseReport,
+} from "../catalog/frame-reuse";
+import { requestedActionIds } from "../catalog/slots";
+import { occurrenceDatasetSchema } from "../catalog/occurrence";
+import {
+  queryCoverage,
+  type CoverageEvidenceRecord,
+} from "../catalog/coverage";
+import {
+  catalogContentDigest,
+  createCatalogInterchange,
+  genericCoverageEvidenceSchema,
+} from "../catalog/interchange";
+import {
+  createCatalogRead,
+  CatalogReadError,
+  catalogRecentRequestSchema,
+} from "./catalog-read";
+import type { YardRepository } from "./storage/repository";
+
+export interface CatalogReviewRuntime {
+  yard: Pick<YardRepository, "snapshot">;
+}
+export interface CatalogReviewEvidence {
+  coverage: readonly CoverageEvidenceRecord[];
+  readFailures?: readonly string[];
+  frameReuse?: FrameReuseCatalog | null;
+  reuseReason?: string | null;
+}
+export type CatalogReviewEvidenceProvider = () =>
+  CatalogReviewEvidence | Promise<CatalogReviewEvidence>;
+const readers = new WeakMap<
+  CatalogReviewRuntime,
+  ReturnType<typeof createCatalogRead>
+>();
+export function catalogReviewReader(runtime: CatalogReviewRuntime) {
+  let reader = readers.get(runtime);
+  if (!reader) {
+    reader = createCatalogRead({ yard: runtime.yard });
+    readers.set(runtime, reader);
+  }
+  return reader;
+}
+/** Exact URL keys only; owner and clock are trusted server arguments, never URL fields. */
+export function parseCatalogReviewSearch(params: URLSearchParams, now: string) {
+  const asOf = timestampSchema.parse(now);
+  const allowed = new Set(["includeStart", "excludeEnd", "limit", "cursor"]);
+  if (params.toString().length > 2048)
+    throw new Error("Invalid catalog query.");
+  for (const key of params.keys())
+    if (!allowed.has(key) || params.getAll(key).length !== 1)
+      throw new Error("Invalid catalog query.");
+  const limit = params.get("limit");
+  if (limit !== null && !/^[1-9]\d?$/.test(limit))
+    throw new Error("Invalid page limit.");
+  if (
+    params.has("cursor") &&
+    (!params.has("includeStart") || !params.has("excludeEnd"))
+  )
+    throw new Error("Cursor traversal requires its exact window.");
+  return catalogRecentRequestSchema.parse({
+    query: {
+      includeStart:
+        params.get("includeStart") ??
+        new Date(Date.parse(asOf) - 86400000).toISOString(),
+      excludeEnd: params.get("excludeEnd") ?? asOf,
+    },
+    page: {
+      ...(limit === null ? {} : { limit: Number(limit) }),
+      ...(params.has("cursor") ? { cursor: params.get("cursor") } : {}),
+    },
+  });
+}
+export const CATALOG_REVIEW_OCCURRENCE = occurrenceDatasetSchema.parse({
+  schemaVersion: 1,
+  id: "chirp-occurrence-claims",
+  version: "san-diego-context-proposal-1",
+  readiness: "unconfigured",
+  regions: [
+    { id: "north-america", label: "North America", parents: [] },
+    { id: "united-states", label: "United States", parents: ["north-america"] },
+    { id: "california", label: "California", parents: ["united-states"] },
+    {
+      id: "southern-california",
+      label: "Southern California",
+      parents: ["california"],
+    },
+    { id: "san-diego", label: "San Diego", parents: ["southern-california"] },
+  ],
+  habitats: [
+    { id: "coastal_urban", label: "Coastal urban yard" },
+    { id: "inland_suburban", label: "Inland suburban yard" },
+    { id: "canyon_scrub_edge", label: "Canyon scrub edge" },
+    { id: "oak_riparian_edge", label: "Oak or riparian edge" },
+    { id: "indoor_patio", label: "Indoor or managed patio" },
+  ],
+  claims: [],
+});
+async function sourceModel() {
+  const facts = SPECIES_FACTS_CATALOG;
+  const aliases = buildFactsAliasRegistry(
+    facts,
+    await catalogContentDigest(facts),
+    `${facts.preparedDate}T00:00:00.000Z`,
+  );
+  const subjects = facts.records.map((record) => ({
+    taxon: factRecordTaxonRef(facts, record.id),
+    packId: ["blue-jay", "northern-cardinal"].includes(record.id)
+      ? "general-reference"
+      : "san-diego-proposed-first-wave",
+  }));
+  return {
+    facts,
+    aliases,
+    subjects,
+    identityResolutions: subjects.map((subject) =>
+      resolveTaxonIdentity(subject.taxon, aliases),
+    ),
+  };
+}
+let source: ReturnType<typeof sourceModel> | undefined;
+/** Existing initialized runtime only. Coverage is injected read evidence, never discovered or generated here. */
+export async function getCatalogReview(
+  runtime: CatalogReviewRuntime,
+  owner: string,
+  params: URLSearchParams,
+  now: string,
+  evidenceProvider?: CatalogReviewEvidenceProvider,
+) {
+  idSchema.parse(owner);
+  const request = parseCatalogReviewSearch(params, now);
+  const { facts, aliases, subjects, identityResolutions } = await (source ??=
+    sourceModel());
+  const readFailures: string[] = [];
+  let evidence: CoverageEvidenceRecord[] = [];
+  let frameReuse: FrameReuseCatalog | undefined;
+  let reuse: FrameReuseReport | null = null;
+  if (evidenceProvider) {
+    try {
+      const supplied = await evidenceProvider();
+      try {
+        if (!Array.isArray(supplied.coverage) || supplied.coverage.length > 2048 - subjects.length * requestedActionIds.length)
+          throw new Error('Candidate evidence exceeds the shared coverage envelope.');
+        evidence = z
+          .array(genericCoverageEvidenceSchema)
+          .max(2048 - subjects.length * requestedActionIds.length)
+          .parse(supplied.coverage);
+        if (
+          new Set(evidence.map((row) => row.id)).size !== evidence.length ||
+          evidence.some((row) => row.id.startsWith("facts-"))
+        )
+          throw new Error("Conflicting provider evidence IDs.");
+      } catch {
+        evidence = [];
+        readFailures.push(
+          "Candidate coverage declarations are invalid; no asset coverage has been inferred.",
+        );
+      }
+      if (supplied.frameReuse) {
+        try {
+          reuse = queryFrameReuse(supplied.frameReuse);
+          frameReuse = frameReuseCatalogSchema.parse(supplied.frameReuse);
+        } catch {
+          readFailures.push(
+            "Frame-reuse declarations are invalid; no reuse eligibility has been inferred.",
+          );
+        }
+      }
+      if (supplied.readFailures?.length)
+        readFailures.push(
+          "Some candidate evidence could not be read; its coverage remains unknown.",
+        );
+    } catch {
+      readFailures.push(
+        "Candidate evidence is unavailable; no coverage has been inferred.",
+      );
+    }
+  } else
+    readFailures.push(
+      "No candidate evidence provider is configured; asset coverage remains unknown.",
+    );
+  // Fact records are actual supplied research, not artwork source/validation or complete biology approval.
+  const factEvidence: CoverageEvidenceRecord[] = subjects.flatMap((subject) =>
+    requestedActionIds.map((slotId) => ({
+      id: `facts-${subject.taxon.taxonId}-${slotId}`,
+      subject,
+      slotId,
+      sourceBinding: null,
+      frameCount: null,
+      distinctFrameCount: null,
+      animation: "unknown",
+      scale: null,
+      gates: {
+        facts: {
+          status: "candidate",
+          evidenceRefs: [subject.taxon.taxonId],
+          binding: null,
+        },
+      },
+    })),
+  );
+  evidence = [...factEvidence, ...evidence];
+  const coverage = queryCoverage({ subjects, evidence });
+  const payload = {
+    facts,
+    aliases,
+    occurrence: CATALOG_REVIEW_OCCURRENCE,
+    coverage: evidence,
+    ...(frameReuse ? { frameReuse } : {}),
+  };
+  const revision = await catalogContentDigest(payload);
+  const interchange = await createCatalogInterchange({
+    id: "chirp-catalog-review",
+    revision,
+    generatedAt: timestampSchema.parse(now),
+    payload,
+  });
+  let recent: ReturnType<
+    ReturnType<typeof createCatalogRead>["recent"]
+  > | null = null;
+  try {
+    recent = catalogReviewReader(runtime).recent(owner, request, now);
+  } catch (cause) {
+    if (cause instanceof CatalogReadError) throw cause;
+    readFailures.push(
+      "Owner evidence is unavailable; no observation counts have been inferred.",
+    );
+  }
+  return {
+    interchange,
+    coverage,
+    reuse,
+    recent,
+    readFailures,
+    asOf: now,
+    identityResolutions,
+  };
+}
+export type CatalogReviewPageData = Awaited<
+  ReturnType<typeof getCatalogReview>
+>;
