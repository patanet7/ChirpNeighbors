+import {
+  createHash,
+  createHmac,
+  randomBytes,
+  timingSafeEqual,
+} from "node:crypto";
+import { z } from "zod";
+import { effectiveEvidenceOf, canonicalJson } from "../domain/yard";
+import { idSchema, timestampSchema } from "../domain/primitives";
+import {
+  recentEvidenceQuerySchema,
+  projectRecentEvidence,
+  type CatalogRecentReadResult,
+} from "../catalog/recent-evidence";
+import { pageRequestSchema, pageInfoSchema } from "../workbench/pagination";
+import { catalogRequestSchema } from "../assets/catalog-contracts";
+import { catalogPinSchema } from "../assets/catalog-pin";
+import type { YardRepository } from "./storage/repository";
+import type { CatalogReleaseRepository } from "./assets/catalog-releases";
+import type { CatalogRequestRepository } from "./assets/catalog-requests";
+
+export const catalogRecentRequestSchema = z
+  .object({
+    query: recentEvidenceQuerySchema,
+    page: pageRequestSchema.default({}),
+  })
+  .strict();
+export type CatalogRecentRequest = z.input<typeof catalogRecentRequestSchema>;
+const hash = (value: unknown) =>
+  createHash("sha256").update(canonicalJson(value)).digest("hex");
+const positionSchema = z
+  .object({
+    version: z.literal(1),
+    query: z.string().regex(/^[a-f0-9]{64}$/),
+    revision: z.string().regex(/^[a-f0-9]{64}$/),
+    offset: z.number().int().nonnegative().safe(),
+    limit: pageRequestSchema.shape.limit,
+  })
+  .strict();
+export class CatalogReadError extends Error {
+  constructor(readonly code: "INVALID_CURSOR" | "STALE_REVISION") {
+    super(
+      code === "STALE_REVISION"
+        ? "Recent evidence changed. Refresh to start a new traversal."
+        : "This recent evidence page is unavailable. Refresh to start again.",
+    );
+    this.name = "CatalogReadError";
+  }
+}
+/** Dependencies are already initialized by the trusted server. Never create/open a repository here.
+ * Owner/now are injected by an authenticated caller, never accepted in request data. This factory
+ * has no job/provider/write port. Process-local cursor signing is not an authentication credential;
+ * a restart requires a fresh traversal. Every page still reads ONLY its injected owner's snapshot.
+ */
+export function createCatalogRead(deps: {
+  yard: Pick<YardRepository, "snapshot">;
+  releases?: Pick<CatalogReleaseRepository, "list" | "getExact">;
+  requests?: Pick<CatalogRequestRepository, "lookupPending">;
+}) {
+  const key = randomBytes(32);
+  const sign = (owner: string, body: string) =>
+    createHmac("sha256", key)
+      .update(JSON.stringify([owner, "recent-evidence-v1", body]))
+      .digest();
+  const encode = (owner: string, position: z.infer<typeof positionSchema>) => {
+    const body = Buffer.from(JSON.stringify(position)).toString("base64url");
+    return `${body}.${sign(owner, body).toString("base64url")}`;
+  };
+  function decode(owner: string, cursor: string) {
+    const [body, signature] = cursor.split(".");
+    if (!body || !signature) throw new CatalogReadError("INVALID_CURSOR");
+    const bytes = Buffer.from(signature, "base64url");
+    if (
+      bytes.length !== 32 ||
+      bytes.toString("base64url") !== signature ||
+      !timingSafeEqual(bytes, sign(owner, body))
+    )
+      throw new CatalogReadError("INVALID_CURSOR");
+    try {
+      const encoded = Buffer.from(body, "base64url");
+      if (encoded.toString("base64url") !== body) throw new Error("encoding");
+      return positionSchema.parse(JSON.parse(encoded.toString("utf8")));
+    } catch {
+      throw new CatalogReadError("INVALID_CURSOR");
+    }
+  }
+  return {
+    recent(
+      owner: string,
+      input: unknown,
+      now: string,
+    ): CatalogRecentReadResult {
+      idSchema.parse(owner);
+      timestampSchema.parse(now);
+      const request = catalogRecentRequestSchema.parse(input);
+      const saved = request.page.cursor
+        ? decode(owner, request.page.cursor)
+        : null;
+      const snapshot = deps.yard.snapshot(owner, now);
+      const projection = projectRecentEvidence(snapshot, request.query, now);
+      const query = hash(projection.query);
+      // Bind correction identity and time eligibility, but not changing wall time or resident TTL.
+      const source = new Map(
+        snapshot.events.map((event) => [event.id, event.source.kind]),
+      );
+      const evidence = effectiveEvidenceOf(snapshot)
+        .map((entry) => ({ ...entry, sourceKind: source.get(entry.eventId) }))
+        .sort((a, b) =>
+          a.eventId < b.eventId ? -1 : a.eventId > b.eventId ? 1 : 0,
+        );
+      const revision = hash({
+        evidence,
+        rows: projection.rows,
+        unknownTimeBySpecies: projection.unknownTimeBySpecies,
+        counts: projection.counts,
+      });
+      if (
+        saved &&
+        (saved.query !== query || saved.limit !== request.page.limit)
+      )
+        throw new CatalogReadError("INVALID_CURSOR");
+      if (saved && saved.revision !== revision)
+        throw new CatalogReadError("STALE_REVISION");
+      const offset = saved?.offset ?? 0;
+      if (offset > projection.rows.length)
+        throw new CatalogReadError("INVALID_CURSOR");
+      const position = {
+        version: 1 as const,
+        query,
+        revision,
+        offset,
+        limit: request.page.limit,
+      };
+      const items = projection.rows.slice(offset, offset + request.page.limit),
+        next = offset + items.length;
+      return {
+        items,
+        revision,
+        query: projection.query,
+        asOf: projection.asOf,
+        counts: projection.counts,
+        unknownTimeBySpecies: projection.unknownTimeBySpecies,
+        semantics: projection.semantics,
+        page: pageInfoSchema.parse({
+          cursor: encode(owner, position),
+          nextCursor:
+            next < projection.rows.length
+              ? encode(owner, { ...position, offset: next })
+              : null,
+          limit: request.page.limit,
+        }),
+      };
+    },
+    listReleases(input: unknown) {
+      const checked = catalogRequestSchema.parse(input);
+      return deps.releases?.list(checked) ?? [];
+    },
+    getExactRelease(input: unknown) {
+      const checked = catalogPinSchema.parse(input);
+      return (
+        deps.releases?.getExact(checked) ?? { status: "unavailable" as const }
+      );
+    },
+    lookupPending(input: unknown) {
+      const checked = catalogRequestSchema.parse(input);
+      return deps.requests?.lookupPending(checked) ?? null;
+    },
+  };
+}
+export type CatalogRead = ReturnType<typeof createCatalogRead>;
