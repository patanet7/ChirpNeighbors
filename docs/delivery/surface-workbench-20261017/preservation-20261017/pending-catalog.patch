+      taxon: r.taxon,
+      status:
+        r.statuses.has("unlikely") &&
+        (r.statuses.has("likely") || r.statuses.has("possible"))
+          ? ("conflicted" as const)
+          : r.statuses.has("likely")
+            ? ("likely" as const)
+            : r.statuses.has("possible")
+              ? ("possible" as const)
+              : ("unlikely" as const),
+      claimIds: [...r.claimIds].sort(),
+      sourceIds: [...r.sourceIds].sort(),
+    }));
