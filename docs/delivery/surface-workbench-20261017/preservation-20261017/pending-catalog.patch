+import { z } from "zod";
+import {
+  effectiveEvidenceOf,
+  sourceSchema,
+  type YardSnapshot,
+} from "../domain/yard";
+import { idSchema, timestampSchema } from "../domain/primitives";
+import type { PageInfo } from "../workbench/pagination";
+
+export const recentEvidenceQuerySchema = z
+  .object({
+    includeStart: timestampSchema,
+    excludeEnd: timestampSchema,
+    sourceKinds: z.array(sourceSchema.shape.kind).min(1).max(4).optional(),
+    includeFixtures: z.boolean().default(false),
+    speciesIds: z.array(idSchema).min(1).max(512).optional(),
+  })
+  .strict()
+  .superRefine((value, context) => {
+    if (Date.parse(value.includeStart) >= Date.parse(value.excludeEnd))
+      context.addIssue({
+        code: "custom",
+        message: "Recent evidence requires includeStart before excludeEnd.",
+      });
+  });
+export type RecentEvidenceQuery = z.input<typeof recentEvidenceQuerySchema>;
+export type RecentEvidenceSourceCounts = Record<
+  z.infer<typeof sourceSchema>["kind"],
+  number
+>;
+export interface RecentEvidenceRow {
+  speciesId: string;
+  evidenceCount: number;
+  firstObservedAt: string;
+  lastObservedAt: string;
+  sourceCounts: RecentEvidenceSourceCounts;
+}
+export interface UnknownTimeEvidenceRow {
+  speciesId: string;
+  evidenceCount: number;
+  sourceCounts: RecentEvidenceSourceCounts;
+}
+export interface RecentEvidenceProjection {
+  query: z.output<typeof recentEvidenceQuerySchema>;
+  asOf: string;
+  rows: RecentEvidenceRow[];
+  unknownTimeBySpecies: UnknownTimeEvidenceRow[];
+  counts: {
+    inWindow: number;
+    unknownTime: number;
+    futureTime: number;
+    outsideWindow: number;
+    excludedFixtures: number;
+    excludedSource: number;
+    excludedSpecies: number;
+  };
+  semantics: "effective-observation-time-only";
+}
+export type CatalogRecentReadResult = Omit<RecentEvidenceProjection, "rows"> & {
+  items: RecentEvidenceRow[];
+  revision: string;
+  page: PageInfo;
+};
+
+const zeroSources = (): RecentEvidenceSourceCounts => ({
+  fixture: 0,
+  manual: 0,
+  model: 0,
+  external: 0,
+});
+const lexical = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
+
+/** An owner-private read projection, not a biodiversity/occurrence or asset-admission claim.
+ * Unknown timestamps stay unknown: ingestion, TTL, promotion and resident creation never substitute.
+ * Fixture exclusion precedes source filtering, and future observation times are excluded even when
+ * the requested half-open window extends beyond now. Each source event contributes at most once.
+ */
+export function projectRecentEvidence(
+  snapshot: YardSnapshot,
+  query: RecentEvidenceQuery,
+  now: string,
+): RecentEvidenceProjection {
+  const checked = recentEvidenceQuerySchema.parse(query);
+  const normalized = {
+    ...checked,
+    includeStart: new Date(checked.includeStart).toISOString(),
+    excludeEnd: new Date(checked.excludeEnd).toISOString(),
+    ...(checked.sourceKinds
+      ? { sourceKinds: [...new Set(checked.sourceKinds)].sort() }
+      : {}),
+    ...(checked.speciesIds
+      ? { speciesIds: [...new Set(checked.speciesIds)].sort() }
+      : {}),
+  };
+  const asOf = new Date(timestampSchema.parse(now)).toISOString();
+  const start = Date.parse(normalized.includeStart),
+    end = Date.parse(normalized.excludeEnd),
+    current = Date.parse(asOf);
+  const kinds = normalized.sourceKinds ? new Set(normalized.sourceKinds) : null;
+  const species = normalized.speciesIds ? new Set(normalized.speciesIds) : null;
+  const events = new Map(snapshot.events.map((event) => [event.id, event]));
+  const rows = new Map<string, RecentEvidenceRow>(),
+    unknown = new Map<string, UnknownTimeEvidenceRow>();
+  const counts = {
+    inWindow: 0,
+    unknownTime: 0,
+    futureTime: 0,
+    outsideWindow: 0,
+    excludedFixtures: 0,
+    excludedSource: 0,
+    excludedSpecies: 0,
+  };
+  for (const evidence of effectiveEvidenceOf(snapshot)) {
+    const event = events.get(evidence.eventId)!;
+    const kind = event.source.kind;
+    if (kind === "fixture" && !normalized.includeFixtures) {
+      counts.excludedFixtures++;
+      continue;
+    }
+    if (kinds && !kinds.has(kind)) {
+      counts.excludedSource++;
+      continue;
+    }
+    if (species && !species.has(evidence.speciesId)) {
+      counts.excludedSpecies++;
+      continue;
+    }
+    if (evidence.observedAt === null) {
+      counts.unknownTime++;
+      const bucket = unknown.get(evidence.speciesId) ?? {
+        speciesId: evidence.speciesId,
+        evidenceCount: 0,
+        sourceCounts: zeroSources(),
+      };
+      bucket.evidenceCount++;
+      bucket.sourceCounts[kind]++;
+      unknown.set(evidence.speciesId, bucket);
+      continue;
+    }
+    const observed = Date.parse(evidence.observedAt);
+    if (observed > current) {
+      counts.futureTime++;
+      continue;
+    }
+    if (observed < start || observed >= end) {
+      counts.outsideWindow++;
+      continue;
+    }
+    const at = new Date(observed).toISOString();
+    const row = rows.get(evidence.speciesId) ?? {
+      speciesId: evidence.speciesId,
+      evidenceCount: 0,
+      firstObservedAt: at,
+      lastObservedAt: at,
+      sourceCounts: zeroSources(),
+    };
+    row.evidenceCount++;
+    row.sourceCounts[kind]++;
+    counts.inWindow++;
+    if (observed < Date.parse(row.firstObservedAt)) row.firstObservedAt = at;
+    if (observed > Date.parse(row.lastObservedAt)) row.lastObservedAt = at;
+    rows.set(evidence.speciesId, row);
+  }
+  return {
+    query: normalized,
+    asOf,
+    rows: [...rows.values()].sort(
+      (a, b) =>
+        Date.parse(b.lastObservedAt) - Date.parse(a.lastObservedAt) ||
+        lexical(a.speciesId, b.speciesId),
+    ),
+    unknownTimeBySpecies: [...unknown.values()].sort((a, b) =>
+      lexical(a.speciesId, b.speciesId),
+    ),
+    counts,
+    semantics: "effective-observation-time-only",
+  };
+}
