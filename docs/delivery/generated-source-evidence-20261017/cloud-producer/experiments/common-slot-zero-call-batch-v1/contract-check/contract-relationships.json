    },
    {
      "input": "rgba-source-artifact-v3",
      "purpose": "Retained private RGBA source wrapper with inputDigest, V4 input and per-frame blob byte/hash descriptors. Not a label for PNG source eligibility handoffs."
    },
    {
      "input": "species-manifest-v6",
      "purpose": "Normalized runtime rectangle manifest. Requires sourceArtifact pin, provenance, normalization, conditioning, neutral-only clips and commonMotion. Not constructed or admitted here."
    },
    {
      "input": "png-file-package-command-v3 / png-workshop-plan-v3",
