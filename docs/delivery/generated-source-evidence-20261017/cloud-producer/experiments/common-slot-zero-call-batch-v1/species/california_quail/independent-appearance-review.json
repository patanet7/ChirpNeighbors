        "codecArtVerdict": "PROVISIONALLY_USEFUL",
        "sourceArtUseful": true,
        "usableClipYield": 1,
        "reason": "Upward head/neck and bill attention is distinct from neutral, with coherent body identity and broad stationary foot stance at normal scale. Minor plumage/outline redraw is tolerable. The source is useful for attention, without approving physical support."
      },
      {
        "id": "look-v2",
        "rawArtVerdict": "HELD",
        "codecArtVerdict": "HELD",
