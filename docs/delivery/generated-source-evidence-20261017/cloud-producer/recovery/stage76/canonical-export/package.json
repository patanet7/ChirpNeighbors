{
  "name": "chirpneighbors",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "start": "node build/index.js",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck": "npm run check",
    "test": "vitest run",
    "lint": "eslint --flag unstable_native_nodejs_ts_config src scripts svelte.config.js *.config.ts --max-warnings 0",
    "format": "prettier --write src svelte.config.js '*.config.ts' 'scripts/**/*.{js,mjs,cjs,ts,mts,cts}' tools/svelte-autofixer/*.json tsconfig*.json scripts/tsconfig.json",
    "test:browser": "python3 scripts/browser-checks.py",
    "contracts:export": "node scripts/export-contract.ts",
    "contracts:check": "node scripts/export-contract.ts --check",
    "test:layered": "python3 scripts/layered-browser-checks.py",
    "test:manifests": "python3 scripts/manifest-browser-checks.py",
    "test:sleep": "python3 scripts/sleep-browser-checks.py",
    "test:arrangement": "python3 scripts/arrangement-browser-checks.py",
    "test:routines": "python3 scripts/routines-browser-checks.py",
    "test:findings": "python3 scripts/findings-browser-checks.py",
    "test:scenes": "python3 scripts/scenes-browser-checks.py",
    "test:recordings": "python3 scripts/recordings-browser-checks.py",
    "test:consolidation": "python3 scripts/consolidation-browser-checks.py",
    "test:auth": "python3 scripts/auth-browser-checks.py",
    "format:check": "prettier --check src svelte.config.js '*.config.ts' 'scripts/**/*.{js,mjs,cjs,ts,mts,cts}' tools/svelte-autofixer/*.json tsconfig*.json scripts/tsconfig.json",
    "test:assets": "python3 scripts/asset-pipeline-browser-checks.py",
    "test:recordings-ui": "python3 scripts/recordings-ui-browser-checks.py",
    "test:operations": "python3 scripts/operations-smoke.py",
    "contracts:clients:check": "node scripts/generate-contract-clients.ts contracts/audio-command-v1.validation.schema.json contracts/audio-event-v1.serialization.schema.json contracts/audio-recording-permit-v1.serialization.schema.json contracts/session-verifier-v1.serialization.schema.json contracts/audio-http-error-v1.serialization.schema.json contracts/json-value-v1.schema.json --output src/lib/contracts/generated --check",
    "quality": "npm run check && npm run check:declarations && npm run test:declarations && npm run check:typescript && npm run test:typescript && npm run lint && npm run check:autofixer && npm run check:css && npm run test:tooling && npm run format:check && npm test && npm run contracts:tools:test && npm run contracts:check && npm run contracts:clients:check && npm run build",
    "test:analysis": "python3 scripts/analysis-browser-checks.py",
    "test:auth-integration": "node scripts/auth-integration.ts",
    "test:recording-lifecycle": "python3 scripts/recording-lifecycle-browser-checks.py",
    "test:image-intake": "python3 scripts/image-intake-browser-checks.py",
    "test:lifecycle-recovery": "python3 scripts/lifecycle-recovery-smoke.py",
    "test:sharing": "python3 scripts/share-browser-checks.py",
    "test:abuse": "python3 scripts/abuse-smoke.py",
    "contracts:tools:test": "node --test scripts/contract-tools/*.test.ts",
    "test:image-v3": "python3 scripts/image-v3-browser-checks.py",
    "test:shapes": "python3 scripts/shape-browser-checks.py",
    "test:evidence": "python3 scripts/evidence-browser-checks.py",
    "test:inventory": "python3 scripts/inventory-browser-checks.py",
    "test:behavior": "python3 scripts/behavior-browser-checks.py",
    "test:ontology": "python3 scripts/ontology-browser-checks.py",
    "test:arrivals": "python3 scripts/arrivals-browser-checks.py",
    "test:analytics": "python3 scripts/analytics-browser-checks.py",
    "test:session-binding": "python3 scripts/session-binding-browser-checks.py",
    "test:pagination": "python3 scripts/workbench-pagination-browser-checks.py",
    "test:png-intake": "python3 scripts/png-intake-browser-checks.py",
    "test:asset-retention": "python3 scripts/asset-retention-browser-checks.py",
    "test:shared-catalog": "python3 scripts/shared-catalog-browser-checks.py",
    "test:environment": "python3 scripts/environment-browser-checks.py",
    "tooling:install": "npm ci --prefix tools/svelte-autofixer --ignore-scripts --no-audit --no-fund",
    "check:autofixer": "node scripts/check-svelte-autofixer.ts",
    "check:css": "node scripts/check-css.ts",
    "test:tooling": "node --test --test-concurrency=1 scripts/style-tools/*.test.ts",
    "test:resources": "python3 scripts/resources-browser-checks.py",
    "check:declarations": "node scripts/check-declarations.ts",
    "test:declarations": "node scripts/declaration-tools/negative-probes.ts",
    "check:typescript": "node scripts/check-typescript.ts",
    "test:typescript": "node scripts/typescript-tools/negative-probes.ts",
    "dev:status": "node scripts/dev.ts status",
    "dev:stop": "node scripts/dev.ts stop",
    "test:dev": "node --test scripts/dev-tools/*.test.ts",
    "test:asset-history": "python3 scripts/asset-history-browser-checks.py"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "better-auth": "1.7.7",
    "jose": "6.2.3",
    "nodemailer": "10.0.16",
    "pixi.js": "8.22.0",
    "sharp": "0.35.5",
    "svelte": "5.57.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.32.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "15.15.0",
    "json-schema-to-typescript": "16.0.0",
    "known-css-properties": "0.37.0",
    "playwright-core": "1.62.0",
    "postcss": "8.5.6",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "7.3.7",
    "vitest": "3.2.4",
    "zod-to-json-schema": "3.25.2"
  }
}
