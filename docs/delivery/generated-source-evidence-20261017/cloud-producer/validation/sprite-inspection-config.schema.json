{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source sprite inspection config1; canonical evaluation labels are external",
  "type": "object",
  "required": [
    "schemaVersion",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alphaCutoff": {
          "type": "integer",
          "default": 128
        },
        "maxOffsetWorld": {
          "type": "integer",
          "default": 1
        },
        "widthRelativeWarn": {
          "type": "number",
          "default": 0.2
        },
        "searchRadiusPixels": {
          "type": "integer",
          "default": 8
        },
        "brightMin": {
          "type": "integer",
          "default": 240
        },
        "brightChromaMax": {
          "type": "integer",
          "default": 15
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "motionIntent",
          "frames"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "speciesId": {
            "type": [
              "string",
              "null"
            ]
          },
          "assetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "clipId": {
            "type": [
              "string",
              "null"
            ]
          },
          "context": {},
          "supportRequirement": {},
          "repairDecision": {},
          "reevaluationRefs": {
            "type": "array"
          },
          "reevaluationLinks": {
            "type": "array"
          },
          "motionIntent": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "registrationExpectedStable": {
                "type": "boolean"
              },
              "expectedROIChanges": {
                "type": "array"
              }
            }
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "png",
                "sha256",
                "action",
                "pose",
                "density",
                "pivot"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "png": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "action": {
                  "type": "string"
                },
                "pose": {
                  "type": "string"
                },
                "density": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "pivot": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "cssScale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "expectedPixelTranslation": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "clipId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "contacts": {
                  "type": "array"
                }
              }
            }
          },
          "stableBodyROI": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "stableMaskPNG": {
            "type": "object",
            "required": [
              "file",
              "sha256"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "contactProbeROIs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "rect"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "rect": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "expectedTrajectory": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "requiredActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actionManifest": {
            "type": "object",
            "required": [
              "file",
              "sha256",
              "actionsPointer"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "actionsPointer": {
                "type": "string"
              }
            }
          },
          "requireBinaryAlpha": {
            "type": "boolean"
          },
          "centerSuggestions": {
            "type": "boolean"
          },
          "codecReceipt": {
            "type": "object",
            "required": [
              "file",
              "sha256",
              "canonicalSource",
              "frameHashesPointer",
              "statusPointer"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "canonicalSource": {
                "type": "object",
                "required": [
                  "file",
                  "sha256",
                  "receiptHashPointer"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "receiptHashPointer": {
                    "type": "string"
                  }
                }
              },
              "frameHashesPointer": {
                "type": "string"
              },
              "frameHashField": {
                "type": "string"
              },
              "statusPointer": {
                "type": "string"
              },
              "rectanglesPointer": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "canonicalEvaluationContract": {
      "type": "object",
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "labelMapPointer": {
          "type": "string"
        }
      }
    }
  }
}
