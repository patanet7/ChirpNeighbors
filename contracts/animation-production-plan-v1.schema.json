{
  "$ref": "#/definitions/AnimationProductionPlanV1",
  "definitions": {
    "AnimationProductionPlanV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "format": {
          "type": "string",
          "const": "animation-production-plan"
        },
        "execution": {
          "type": "string",
          "const": "planning-only"
        },
        "model": {
          "type": "string",
          "const": "unconfigured"
        },
        "generatedFrames": {
          "type": "number",
          "const": 0
        },
        "taxonFidelityReviewed": {
          "type": "boolean",
          "const": false
        },
        "taxonomy": {
          "type": "object",
          "properties": {
            "catalog": {
              "type": "string",
              "const": "chirp-display-catalog"
            },
            "version": {
              "type": "number",
              "const": 1
            },
            "speciesId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]*$"
            }
          },
          "required": [
            "catalog",
            "version",
            "speciesId"
          ],
          "additionalProperties": false
        },
        "scientificName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "allOf": [
            {
              "type": "string",
              "pattern": "^(?:[\\u0000-\\uFFFF](?:[\\u0000-\\uFFFF](?:[\\u0000-\\uFFFF]|[^\\u0000-\\uFFFF])|[^\\u0000-\\uFFFF])|[^\\u0000-\\uFFFF](?:[\\u0000-\\uFFFF]|[^\\u0000-\\uFFFF]))"
            }
          ]
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "specificationSha256": {
          "$ref": "#/definitions/AnimationProductionPlanV1/properties/inputSha256"
        },
        "specification": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "templateVersion": {
              "type": "string",
              "const": "chirp-animation-prompts@1"
            },
            "status": {
              "type": "string",
              "const": "proposed"
            },
            "canvas": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number",
                  "const": 32
                },
                "height": {
                  "type": "number",
                  "const": 32
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "logicalPixelSize": {
              "type": "number",
              "const": 1
            },
            "paletteLimit": {
              "type": "number",
              "const": 32
            },
            "alpha": {
              "type": "string",
              "const": "binary-transparent-background"
            },
            "ticksPerSecond": {
              "type": "number",
              "const": 30
            },
            "totalFrames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "decodedPixels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "clips": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "idle",
                      "moving",
                      "perching",
                      "singing",
                      "feeding",
                      "bathing",
                      "sleeping",
                      "playing",
                      "nesting"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "const": "right-facing-mirrorable"
                  },
                  "loop": {
                    "type": "boolean"
                  },
                  "completion": {
                    "type": "string",
                    "enum": [
                      "repeat",
                      "hold-final-pose"
                    ]
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "frames": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "frame": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "phase": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "durationTicks": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 300
                        },
                        "proposedPivot": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 256
                            },
                            "y": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 256
                            }
                          },
                          "required": [
                            "x",
                            "y"
                          ],
                          "additionalProperties": false
                        },
                        "contactRequirements": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "left-foot",
                              "right-foot",
                              "perch",
                              "ground"
                            ]
                          },
                          "maxItems": 4
                        }
                      },
                      "required": [
                        "frame",
                        "phase",
                        "durationTicks",
                        "proposedPivot",
                        "contactRequirements"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 64
                  },
                  "entry": {
                    "type": "string",
                    "const": "review-against-idle-support-and-silhouette"
                  },
                  "exit": {
                    "type": "string",
                    "const": "review-against-idle-support-and-silhouette"
                  },
                  "loopReview": {
                    "type": "string",
                    "enum": [
                      "last-to-first-pixels-pivot-contacts",
                      "not-looping-review-terminal-hold"
                    ]
                  }
                },
                "required": [
                  "action",
                  "direction",
                  "loop",
                  "completion",
                  "purpose",
                  "frames",
                  "entry",
                  "exit",
                  "loopReview"
                ],
                "additionalProperties": false
              },
              "minItems": 9,
              "maxItems": 9
            }
          },
          "required": [
            "schemaVersion",
            "templateVersion",
            "status",
            "canvas",
            "logicalPixelSize",
            "paletteLimit",
            "alpha",
            "ticksPerSecond",
            "totalFrames",
            "decodedPixels",
            "clips"
          ],
          "additionalProperties": false
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]{0,159}$"
              },
              "originalSha256": {
                "$ref": "#/definitions/AnimationProductionPlanV1/properties/inputSha256"
              },
              "decodedSha256": {
                "$ref": "#/definitions/AnimationProductionPlanV1/properties/inputSha256"
              },
              "status": {
                "type": "string",
                "const": "declared-not-byte-verified"
              }
            },
            "required": [
              "id",
              "originalSha256",
              "decodedSha256",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "references-missing",
              "reference-bytes-unverified",
              "reference-is-fixture",
              "reference-rights-unreviewed",
              "generation-permission-unreviewed",
              "species-fidelity-unreviewed",
              "model-unconfigured",
              "art-direction-unapproved",
              "output-review-required"
            ]
          },
          "minItems": 3,
          "maxItems": 9
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "idle",
                  "moving",
                  "perching",
                  "singing",
                  "feeding",
                  "bathing",
                  "sleeping",
                  "playing",
                  "nesting"
                ]
              },
              "templateVersion": {
                "type": "string",
                "const": "chirp-animation-prompts@1"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "negativePrompt": {
                "$ref": "#/definitions/AnimationProductionPlanV1/properties/prompts/items/properties/prompt"
              },
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "frame": {
                      "$ref": "#/definitions/AnimationProductionPlanV1/properties/specification/properties/clips/items/properties/frames/items/properties/frame"
                    },
                    "prompt": {
                      "$ref": "#/definitions/AnimationProductionPlanV1/properties/prompts/items/properties/prompt"
                    }
                  },
                  "required": [
                    "frame",
                    "prompt"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              }
            },
            "required": [
              "action",
              "templateVersion",
              "prompt",
              "negativePrompt",
              "frames"
            ],
            "additionalProperties": false
          },
          "minItems": 9,
          "maxItems": 9
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnimationProductionPlanV1/properties/prompts/items/properties/prompt"
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "schemaVersion",
        "format",
        "execution",
        "model",
        "generatedFrames",
        "taxonFidelityReviewed",
        "taxonomy",
        "scientificName",
        "inputSha256",
        "specificationSha256",
        "specification",
        "references",
        "blockers",
        "prompts",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/animation-production-plan-v1.schema.json",
  "description": "Owner-private animation planning and existing job command structural boundary. Proposed per-clip frames, timing, pivots, contacts and prompts are engineering plans, never generated assets, measured biology or review approval. Authoritative catalog identity, reference consistency, contiguous frame allocation, loop/transition requirements, prompt correspondence and mandatory production blockers require Zod semantics. Immutable job binding, actual byte hashes, ownership, input admission and provider execution require server validation. No renderable pixels, provider execution, external uploads or public release are authorized by this schema."
}
