{
  "$ref": "#/definitions/CommonIntakeReportV2",
  "definitions": {
    "CommonIntakeReportV2": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "boundary": {
          "type": "string",
          "enum": [
            "asset-packaging-input-v4",
            "asset-packaging-input-v5"
          ]
        },
        "metadataComplete": {
          "type": "boolean"
        },
        "sourceAdmitted": {
          "type": "boolean",
          "const": false
        },
        "rightsGranted": {
          "type": "boolean",
          "const": false
        },
        "referenceRightsAssessed": {
          "type": "boolean",
          "const": false
        },
        "generationInputsAssessed": {
          "type": "boolean",
          "const": false
        },
        "physicalSupportReviewed": {
          "type": "boolean",
          "const": false
        },
        "browserAcceptance": {
          "type": "string",
          "const": "pending"
        },
        "reviewRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 8
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "category": {
                "type": "string",
                "enum": [
                  "output-use-declaration",
                  "runtime-reference-binding",
                  "source-metadata"
                ]
              },
              "responsibleParty": {
                "type": "string",
                "enum": [
                  "authorized-requester",
                  "runtime-integrator",
                  "source-producer"
                ]
              }
            },
            "required": [
              "path",
              "code",
              "message",
              "category",
              "responsibleParty"
            ],
            "additionalProperties": false
          },
          "maxItems": 20000
        },
        "classificationCounts": {
          "type": "object",
          "properties": {
            "outputUseDeclaration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "runtimeReferenceBinding": {
              "$ref": "#/definitions/CommonIntakeReportV2/properties/classificationCounts/properties/outputUseDeclaration"
            },
            "sourceMetadata": {
              "$ref": "#/definitions/CommonIntakeReportV2/properties/classificationCounts/properties/outputUseDeclaration"
            }
          },
          "required": [
            "outputUseDeclaration",
            "runtimeReferenceBinding",
            "sourceMetadata"
          ],
          "additionalProperties": false
        },
        "sourceDeclarationState": {
          "type": "string",
          "enum": [
            "unparseable",
            "invalid-declaration",
            "requires-recorded-review"
          ]
        },
        "sourceDeclarationIssues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 16
        }
      },
      "required": [
        "schemaVersion",
        "boundary",
        "metadataComplete",
        "sourceAdmitted",
        "rightsGranted",
        "referenceRightsAssessed",
        "generationInputsAssessed",
        "physicalSupportReviewed",
        "browserAcceptance",
        "reviewRequired",
        "issues",
        "classificationCounts",
        "sourceDeclarationState",
        "sourceDeclarationIssues"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/common-intake-report-v2.schema.json",
  "description": "Versioned private image-pipeline structural boundary: legacy render v2, pose render v3 with optional reviewed shape v1, packaging input v2, retained RGBA source v1, and local reference/image stages v1. Actual byte hashes, palette/grid/alpha rules, graph/reference/catalog consistency, supported strategy and review/ownership require runtime admission. Source artifacts can contain private pixel bytes and are not public projections. Structural validation grants no provider execution, species fidelity or review authorization."
}
