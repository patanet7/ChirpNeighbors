{
  "$ref": "#/definitions/FindingCommandV1",
  "definitions": {
    "FindingCommandV1": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "manual-finding"
            },
            "finding": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "speciesId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  }
                },
                "observedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "schemaVersion",
                "id",
                "speciesId",
                "observedAt",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "action",
            "finding"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "correct-events"
            },
            "corrections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "type": "number",
                    "const": 1
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "eventId": {
                    "$ref": "#/definitions/FindingCommandV1/anyOf/0/properties/finding/properties/speciesId"
                  },
                  "expected": {
                    "type": "object",
                    "properties": {
                      "speciesId": {
                        "$ref": "#/definitions/FindingCommandV1/anyOf/0/properties/finding/properties/speciesId"
                      },
                      "observedAt": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/FindingCommandV1/anyOf/0/properties/finding/properties/observedAt/anyOf/0"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "correctionId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "uuid"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "speciesId",
                      "observedAt",
                      "correctionId"
                    ],
                    "additionalProperties": false
                  },
                  "replacement": {
                    "type": "object",
                    "properties": {
                      "speciesId": {
                        "$ref": "#/definitions/FindingCommandV1/anyOf/0/properties/finding/properties/speciesId"
                      },
                      "observedAt": {
                        "$ref": "#/definitions/FindingCommandV1/anyOf/1/properties/corrections/items/properties/expected/properties/observedAt"
                      }
                    },
                    "required": [
                      "speciesId",
                      "observedAt"
                    ],
                    "additionalProperties": false
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "schemaVersion",
                  "id",
                  "eventId",
                  "expected",
                  "replacement",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 100
            }
          },
          "required": [
            "action",
            "corrections"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/finding-command-v1.schema.json",
  "description": "Owner-private manual intake and append-only corrections. Species must already be available in the receiving catalog. Expected revisions, receipts, ownership and atomicity are enforced by the receiving server; no provider connection is implied."
}
