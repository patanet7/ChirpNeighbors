{
  "$ref": "#/definitions/PinAnimationCommandV2",
  "definitions": {
    "PinAnimationCommandV2": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "action": {
          "type": "string",
          "const": "pin-animation"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "birdId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        "expectedArtworkId": {
          "anyOf": [
            {
              "$ref": "#/definitions/PinAnimationCommandV2/properties/birdId"
            },
            {
              "type": "null"
            }
          ]
        },
        "pin": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "artifactId": {
              "$ref": "#/definitions/PinAnimationCommandV2/properties/pin/properties/jobId"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "jobId",
            "artifactId",
            "version",
            "contentDigest"
          ],
          "additionalProperties": false
        },
        "selection": {
          "type": "string",
          "enum": [
            "latest-preview",
            "previous-preview"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "action",
        "requestId",
        "birdId",
        "expectedArtworkId",
        "pin",
        "selection"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/pin-animation-command-v2.schema.json",
  "description": "Versioned private image-pipeline structural boundary: legacy render v2, pose render v3 with optional reviewed shape v1, packaging input v2, retained RGBA source v1, and local reference/image stages v1. Actual byte hashes, palette/grid/alpha rules, graph/reference/catalog consistency, supported strategy and review/ownership require runtime admission. Source artifacts can contain private pixel bytes and are not public projections. Structural validation grants no provider execution, species fidelity or review authorization."
}
