            "follow-weather",
            "clear",
            "cloudy",
            "rain",
            "snow",
            "fog"
          ]
        },
        "hour": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 24
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "type": "object",
          "properties": {
            "cloud": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "rain": {
              "anyOf": [
                {
                  "$ref": "#/definitions/EnvironmentControlsV1/properties/effects/properties/cloud/anyOf/0"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snow": {
              "anyOf": [
                {
                  "$ref": "#/definitions/EnvironmentControlsV1/properties/effects/properties/cloud/anyOf/0"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fog": {
              "anyOf": [
                {
                  "$ref": "#/definitions/EnvironmentControlsV1/properties/effects/properties/cloud/anyOf/0"
                },
                {
                  "type": "null"
                }
              ]
            },
            "wind": {
              "anyOf": [
                {
                  "$ref": "#/definitions/EnvironmentControlsV1/properties/effects/properties/cloud/anyOf/0"
                },
                {
                  "type": "null"
                }
              ]
            }
