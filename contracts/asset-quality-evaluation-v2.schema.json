{
  "$ref": "#/definitions/AssetQualityEvaluationV2",
  "definitions": {
    "AssetQualityEvaluationV2": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "authority": {
          "type": "string",
          "const": "asset-quality-evaluation-v2"
