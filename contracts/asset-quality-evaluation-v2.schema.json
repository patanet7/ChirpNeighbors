            "canvas": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "assetId",
            "speciesId",
            "contentDigest",
            "sourcePngSha256",
            "rgbaSha256",
            "manifestSha256",
            "geometrySha256",
            "canvas"
          ],
          "additionalProperties": false
        },
        "requirement": {
          "type": "object",
