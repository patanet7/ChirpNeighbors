                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "sha256": {
                      "$ref": "#/definitions/AssetQualityEvaluationV2/properties/subject/properties/contentDigest"
                    }
                  },
                  "required": [
                    "id",
                    "version",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "support": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "sceneId": {
                      "$ref": "#/definitions/AssetQualityEvaluationV2/properties/reportId"
                    },
                    "sceneVersion": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "objectId": {
                      "$ref": "#/definitions/AssetQualityEvaluationV2/properties/reportId"
