            "sha256": {
              "$ref": "#/definitions/AssetQualityEvaluationV2/properties/subject/properties/contentDigest"
            },
            "speciesId": {
              "$ref": "#/definitions/AssetQualityEvaluationV2/properties/reportId"
            },
            "activity": {
              "type": "string",
              "enum": [
                "idle",
                "moving",
                "perching",
                "singing",
                "feeding",
                "bathing",
                "sleeping",
                "playing",
                "nesting"
              ]
            },
            "motionPhase": {
              "type": "string",
              "enum": [
                "grounded",
                "walk",
                "hop",
                "takeoff",
                "flight",
                "landing"
              ]
            },
            "requestedClip": {
              "type": "string",
              "enum": [
                "idle",
                "moving",
                "perching",
                "singing",
                "feeding",
                "bathing",
                "sleeping",
                "playing",
                "nesting",
                "blink",
                "look",
                "takeoff",
                "flight",
                "landing"
              ]
            },
            "facing": {
