                  "species-identity-anatomy",
                  "pose-action-phase",
                  "support-contact",
                  "registration-centering",
                  "relative-scale",
                  "palette-style",
                  "transparency-noise",
                  "temporal-stability",
                  "technical-budgets",
                  "runtime-adoption"
