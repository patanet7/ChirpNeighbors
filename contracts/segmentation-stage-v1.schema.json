{
  "$ref": "#/definitions/SegmentationStageV1",
  "definitions": {
    "SegmentationStageV1": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "encoding": {
              "type": "string",
              "const": "binary-mask-u8"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number",
                "enum": [
                  0,
                  255
                ]
              },
              "minItems": 1,
              "maxItems": 65536
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "adapter": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]*$"
                },
                "version": {
                  "$ref": "#/definitions/SegmentationStageV1/anyOf/0/properties/adapter/properties/id"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "encoding",
            "values",
            "sha256",
            "adapter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "encoding": {
              "type": "string",
              "const": "logits-f32-le"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 1,
              "maxItems": 65536
            },
            "sha256": {
              "$ref": "#/definitions/SegmentationStageV1/anyOf/0/properties/sha256"
            },
            "adapter": {
              "$ref": "#/definitions/SegmentationStageV1/anyOf/0/properties/adapter"
            }
          },
          "required": [
            "encoding",
            "values",
            "sha256",
            "adapter"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/segmentation-stage-v1.schema.json",
  "description": "Versioned private image-pipeline structural boundary: legacy render v2, pose render v3 with optional reviewed shape v1, packaging input v2, retained RGBA source v1, and local reference/image stages v1. Actual byte hashes, palette/grid/alpha rules, graph/reference/catalog consistency, supported strategy and review/ownership require runtime admission. Source artifacts can contain private pixel bytes and are not public projections. Structural validation grants no provider execution, species fidelity or review authorization."
}
