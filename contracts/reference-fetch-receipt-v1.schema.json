{
  "$ref": "#/definitions/ReferenceFetchReceiptV1",
  "definitions": {
    "ReferenceFetchReceiptV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "candidateId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]{0,159}$"
        },
        "source": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/ReferenceFetchReceiptV1/properties/candidateId"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "originalUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "pageUrl": {
          "$ref": "#/definitions/ReferenceFetchReceiptV1/properties/originalUrl"
        },
        "fetchedAt": {
          "type": "string",
          "pattern": "^(([0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|(02)-(0[1-9]|1[0-9]|2[0-8])))T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?(Z)(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha1": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "mime": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        },
        "license": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "CC0",
                "CC-BY",
                "CC-BY-SA",
                "CC-BY-NC",
                "CC-BY-ND",
                "CC-BY-NC-SA",
                "CC-BY-NC-ND",
                "PDM",
                "unknown"
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-4]\\.[05]$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ReferenceFetchReceiptV1/properties/originalUrl"
                },
                {
                  "type": "null"
                }
              ]
            },
            "declaredName": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "attribution": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ReferenceFetchReceiptV1/properties/license/properties/declaredName/anyOf/0"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "recognized",
                "unknown",
                "conflicting"
              ]
            },
            "restrictions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ReferenceFetchReceiptV1/properties/license/properties/declaredName/anyOf/0"
              },
              "maxItems": 8
            }
          },
          "required": [
            "id",
            "version",
            "url",
            "declaredName",
            "attribution",
            "status",
            "restrictions"
          ],
          "additionalProperties": false
        },
        "creator": {
          "$ref": "#/definitions/ReferenceFetchReceiptV1/properties/license/properties/declaredName/anyOf/0"
        },
        "rightsReview": {
          "type": "string",
          "const": "required"
        },
        "speciesReview": {
          "type": "string",
          "const": "required"
        },
        "poseReview": {
          "type": "string",
          "const": "required"
        },
        "generationApproved": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "candidateId",
        "source",
        "originalUrl",
        "pageUrl",
        "fetchedAt",
        "sha256",
        "sha1",
        "bytes",
        "mime",
        "license",
        "creator",
        "rightsReview",
        "speciesReview",
        "poseReview",
        "generationApproved"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/reference-fetch-receipt-v1.schema.json",
  "description": "Owner-private reference discovery structural boundary. Versioned source descriptors, intended-use policies, scientific-name queries, metadata-only results and fetch receipts preserve explicit review requirements. Scientific/catalog identity, URL safety, unique pins and candidates, status correlations and snapshot consistency require source refinements. Known adapter admission, redirect/host restrictions, transport budgets, cancellation, original-byte hashes, per-file rights decisions and source freshness require authoritative server checks. Unknown source pins are not execution permission. Text matches and license metadata are unreviewed declarations, never species fidelity, legal clearance, generation permission, selectable artwork or public release. Discovery contains zero downloads and zero generated frames; original fetching requires a separate explicit caller."
}
