{
  "$ref": "#/definitions/SpeciesManifestV3",
  "definitions": {
    "SpeciesManifestV3": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 3
        },
        "speciesId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "representation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fixture": {
          "type": "boolean"
        },
        "taxonFidelityReviewed": {
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "const": "pixel-rects"
        },
        "canvas": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "$ref": "#/definitions/SpeciesManifestV3/properties/frames/items/items/properties/x"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                "color": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height",
                "color"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 4096
          },
          "minItems": 1,
          "maxItems": 64
        },
        "clips": {
          "type": "object",
          "properties": {
            "idle": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "moving",
                    "perching",
                    "singing",
                    "feeding",
                    "bathing",
                    "sleeping",
                    "playing",
                    "nesting"
                  ]
                },
                "direction": {
                  "type": "string",
                  "const": "right-facing-mirrorable"
                },
                "loop": {
                  "type": "boolean"
                },
                "poses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "frame": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 63
                      },
                      "durationTicks": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 300
                      },
                      "pivot": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 256
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 256
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "contacts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle/properties/poses/items/properties/pivot/properties/x"
                            },
                            "y": {
                              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle/properties/poses/items/properties/pivot/properties/y"
                            },
                            "kind": {
                              "type": "string",
                              "enum": [
                                "left-foot",
                                "right-foot",
                                "perch",
                                "ground"
                              ]
                            }
                          },
                          "required": [
                            "x",
                            "y",
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 4
                      },
                      "poseId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]*$"
                      },
                      "rotation": {
                        "type": "number",
                        "minimum": -0.5,
                        "maximum": 0.5
                      }
                    },
                    "required": [
                      "frame",
                      "durationTicks",
                      "pivot",
                      "contacts",
                      "poseId",
                      "rotation"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 256
                }
              },
              "required": [
                "action",
                "direction",
                "loop",
                "poses"
              ],
              "additionalProperties": false
            },
            "moving": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle"
            },
            "perching": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle"
            },
            "singing": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle"
            },
            "feeding": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle"
            },
            "bathing": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle"
            },
            "sleeping": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle"
            },
            "playing": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle"
            },
            "nesting": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle"
            }
          },
          "required": [
            "idle"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "deterministic_fixture",
                "provider",
                "user_upload"
              ]
            },
            "creator": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/speciesId"
            },
            "sourceVersion": {
              "$ref": "#/definitions/SpeciesManifestV3/properties/speciesId"
            },
            "references": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SpeciesManifestV3/properties/speciesId"
              },
              "maxItems": 32
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "usage": {
              "type": "string",
              "enum": [
                "development-only",
                "cleared"
              ]
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "source",
            "creator",
            "sourceVersion",
            "references",
            "license",
            "usage",
            "attribution"
          ],
          "additionalProperties": false
        },
        "conditioning": {
          "type": "object",
          "properties": {
            "taxonomy": {
              "type": "object",
              "properties": {
                "catalog": {
                  "type": "string",
                  "const": "chirp-display-catalog"
                },
                "version": {
                  "type": "number",
                  "const": 1
                },
                "speciesId": {
                  "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                }
              },
              "required": [
                "catalog",
                "version",
                "speciesId"
              ],
              "additionalProperties": false
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "species",
                        "style",
                        "pose"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 3
                  },
                  "pin": {
                    "type": "object",
                    "properties": {
                      "jobId": {
                        "$ref": "#/definitions/SpeciesManifestV3/properties/speciesId"
                      },
                      "artifactId": {
                        "$ref": "#/definitions/SpeciesManifestV3/properties/speciesId"
                      },
                      "version": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "contentDigest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "jobId",
                      "artifactId",
                      "version",
                      "contentDigest"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "roles",
                  "pin"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 16
            },
            "poseGraph": {
              "type": "object",
              "properties": {
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                      },
                      "frame": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 63
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "idle",
                          "moving",
                          "perching",
                          "singing",
                          "feeding",
                          "bathing",
                          "sleeping",
                          "playing",
                          "nesting"
                        ]
                      },
                      "referenceId": {
                        "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                      }
                    },
                    "required": [
                      "id",
                      "frame",
                      "action",
                      "referenceId"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 576
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                      },
                      "to": {
                        "$ref": "#/definitions/SpeciesManifestV3/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                      }
                    },
                    "required": [
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 2304
                }
              },
              "required": [
                "nodes",
                "edges"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "taxonomy",
            "references",
            "poseGraph"
          ],
          "additionalProperties": false
        },
        "sourceArtifact": {
          "$ref": "#/definitions/SpeciesManifestV3/properties/conditioning/properties/references/items/properties/pin"
        },
        "normalization": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "lossless-rgba-rects-v2"
            },
            "alpha": {
              "type": "string",
              "const": "binary"
            },
            "logicalPixelSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "palette": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777215
              },
              "minItems": 1,
              "maxItems": 64
            },
            "loopEdges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "idle",
                      "moving",
                      "perching",
                      "singing",
                      "feeding",
                      "bathing",
                      "sleeping",
                      "playing",
                      "nesting"
                    ]
                  },
                  "comparedPixels": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65536
                  },
                  "changedPixels": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65536
                  },
                  "pivotDistance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 512
                  },
                  "contactLayoutChanged": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "action",
                  "comparedPixels",
                  "changedPixels",
                  "pivotDistance",
                  "contactLayoutChanged"
                ],
                "additionalProperties": false
              },
              "maxItems": 9
            }
          },
          "required": [
            "algorithm",
            "alpha",
            "logicalPixelSize",
            "palette",
            "loopEdges"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "speciesId",
        "representation",
        "fixture",
        "taxonFidelityReviewed",
        "format",
        "canvas",
        "frames",
        "clips",
        "provenance",
        "conditioning",
        "sourceArtifact",
        "normalization"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/species-manifest-v3.schema.json",
  "description": "Reviewed reusable species rendering manifest structural boundary. V2 fixed-tick clips remain compatible; V3 carries per-pose timing/anchors, taxonomy and reference pins, pose graph and measured normalization metadata. Frame/graph/reference/catalog consistency and actual review authorization require source/runtime admission. Existing technical fixture pixels only; structural validation does not establish species fidelity or approved artwork."
}
