{
  "$ref": "#/definitions/DevWorkbenchPlaybackV1",
  "definitions": {
    "DevWorkbenchPlaybackV1": {
      "type": "object",
      "properties": {
        "initial": {
          "type": "object",
          "properties": {
            "control": {
              "type": "object",
              "properties": {
                "seed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "paused": {
                  "type": "boolean"
                },
                "speed": {
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 8
                }
              },
              "required": [
                "seed",
                "paused",
                "speed"
              ],
              "additionalProperties": false
            },
            "physical": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "precipitationMmPerHour": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 500
                },
                "snowFraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "temperatureC": {
                  "type": "number",
                  "minimum": -30,
                  "maximum": 40
                },
                "speed": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 60
                },
                "replayRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "showBounds": {
                  "type": "boolean"
                },
                "initialBathLitres": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 6
                },
                "resumeRevision": {
                  "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/physical/properties/replayRevision"
                },
                "pumpLitresPerMinute": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 12
                },
                "drainLitresPerMinute": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 12
                },
                "initialReservoirLitres": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 12
                }
              },
              "required": [
                "enabled",
                "precipitationMmPerHour",
                "snowFraction",
                "temperatureC",
                "speed",
                "replayRevision",
                "showBounds",
                "initialBathLitres"
              ],
              "additionalProperties": false
            },
            "environment": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "condition": {
                  "type": "string",
                  "enum": [
                    "follow-weather",
                    "clear",
                    "cloudy",
                    "rain",
                    "snow",
                    "fog"
                  ]
                },
                "hour": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 24
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "effects": {
                  "type": "object",
                  "properties": {
                    "cloud": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "rain": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/environment/properties/effects/properties/cloud/anyOf/0"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "snow": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/environment/properties/effects/properties/cloud/anyOf/0"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fog": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/environment/properties/effects/properties/cloud/anyOf/0"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "wind": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/environment/properties/effects/properties/cloud/anyOf/0"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "cloud",
                    "rain",
                    "snow",
                    "fog",
                    "wind"
                  ],
                  "additionalProperties": false
                },
                "transitionSeconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30
                }
              },
              "required": [
                "schemaVersion",
                "condition",
                "hour",
                "effects",
                "transitionSeconds"
              ],
              "additionalProperties": false
            },
            "selection": {
              "type": "object",
              "properties": {
                "actorId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "targetObjectId": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/selection/properties/actorId/anyOf/0"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "actorId",
                "targetObjectId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "control",
            "physical",
            "environment",
            "selection"
          ],
          "additionalProperties": false
        },
        "current": {
          "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial"
        },
        "timeline": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "step"
                  },
                  "ticks": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300
                  }
                },
                "required": [
                  "type",
                  "ticks"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "clock"
                  },
                  "control": {
                    "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/control"
                  }
                },
                "required": [
                  "type",
                  "control"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "physical"
                  },
                  "options": {
                    "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/physical"
                  }
                },
                "required": [
                  "type",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "actorId": {
                    "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/selection/properties/actorId"
                  },
                  "targetObjectId": {
                    "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/selection/properties/targetObjectId"
                  },
                  "type": {
                    "type": "string",
                    "const": "selection"
                  }
                },
                "required": [
                  "actorId",
                  "targetObjectId",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "interaction"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "drinking",
                      "bathing",
                      "cancel"
                    ]
                  }
                },
                "required": [
                  "type",
                  "action"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "environment"
                  },
                  "controls": {
                    "$ref": "#/definitions/DevWorkbenchPlaybackV1/properties/initial/properties/environment"
                  }
                },
                "required": [
                  "type",
                  "controls"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 2048
        }
      },
      "required": [
        "initial",
        "current",
        "timeline"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/dev-workbench-playback-v1.schema.json",
  "description": "Structural developer scenario and shared runtime boundaries. The strict production Zod/domain authorities additionally enforce owner/session binding, exact immutable source pins, cross-record matching, CAS/idempotency, version/seed semantics, selection intent identity and bounded fixed-tick execution. Generated schemas never authorize execution; application semantic validation is mandatory. Scenario storage is isolated and cannot write back to an owner yard."
}
