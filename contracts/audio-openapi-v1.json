{
  "components": {
    "schemas": {
      "AudioAnalyzeCommand": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "audio.analyze",
            "title": "Kind",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/ModelPin"
          },
          "observedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^([1-9]\\d{3}|0[1-9]\\d{2}|00[1-9]\\d|000[1-9])-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedat"
          },
          "recording": {
            "$ref": "#/components/schemas/RecordingRef"
          },
          "requestId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Requestid",
            "type": "string"
          },
          "reviewThreshold": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Reviewthreshold",
            "type": "number"
          },
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "kind",
          "requestId",
          "traceId",
          "recording",
          "model",
          "observedAt",
          "reviewThreshold"
        ],
        "title": "AudioAnalyzeCommand",
        "type": "object"
      },
      "AudioCompletedEvent": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "audio.completed",
            "title": "Kind",
            "type": "string"
          },
          "observedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^([1-9]\\d{3}|0[1-9]\\d{2}|00[1-9]\\d|000[1-9])-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedat"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProviderProvenance"
          },
          "rawCandidates": {
            "items": {
              "$ref": "#/components/schemas/RawCandidate"
            },
            "maxItems": 200,
            "title": "Rawcandidates",
            "type": "array"
          },
          "recording": {
            "$ref": "#/components/schemas/RecordingRef"
          },
          "requestId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Requestid",
            "type": "string"
          },
          "reviewCandidates": {
            "items": {
              "$ref": "#/components/schemas/ReviewCandidate"
            },
            "maxItems": 200,
            "title": "Reviewcandidates",
            "type": "array"
          },
          "reviewThreshold": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Reviewthreshold",
            "type": "number"
          },
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "summary": {
            "$ref": "#/components/schemas/AudioSummary"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "kind",
          "requestId",
          "traceId",
          "observedAt",
          "recording",
          "provenance",
          "summary",
          "reviewThreshold",
          "rawCandidates",
          "reviewCandidates"
        ],
        "title": "AudioCompletedEvent",
        "type": "object"
      },
      "AudioFailedEvent": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "discriminator": {
              "mapping": {
                "cancelled": "#/components/schemas/CancelledError",
                "conflict": "#/components/schemas/ConflictError",
                "invalid_audio": "#/components/schemas/InvalidAudioError",
                "provider_blocked": "#/components/schemas/ProviderBlockedError",
                "provider_failure": "#/components/schemas/ProviderFailureError",
                "recording_unavailable": "#/components/schemas/RecordingUnavailableError"
              },
              "propertyName": "code"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/RecordingUnavailableError"
              },
              {
                "$ref": "#/components/schemas/InvalidAudioError"
              },
              {
                "$ref": "#/components/schemas/ConflictError"
              },
              {
                "$ref": "#/components/schemas/CancelledError"
              },
              {
                "$ref": "#/components/schemas/ProviderBlockedError"
              },
              {
                "$ref": "#/components/schemas/ProviderFailureError"
              }
            ],
            "title": "Error"
          },
          "kind": {
            "const": "audio.failed",
            "title": "Kind",
            "type": "string"
          },
          "requestId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Requestid",
            "type": "string"
          },
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "kind",
          "requestId",
          "traceId",
          "error"
        ],
        "title": "AudioFailedEvent",
        "type": "object"
      },
      "AudioHTTPError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "authentication_required",
              "invalid_request",
              "service_unavailable",
              "origin_rejected",
              "request_too_large"
            ],
            "title": "Code",
            "type": "string"
          },
          "kind": {
            "const": "audio.rejected",
            "title": "Kind",
            "type": "string"
          },
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "kind",
          "code",
          "traceId"
        ],
        "title": "AudioHTTPError",
        "type": "object"
      },
      "AudioSummary": {
        "additionalProperties": false,
        "properties": {
          "analyzedFrames": {
            "maximum": 480000.0,
            "minimum": 1.0,
            "title": "Analyzedframes",
            "type": "integer"
          },
          "analyzedSampleRate": {
            "const": 16000,
            "title": "Analyzedsamplerate",
            "type": "integer"
          },
          "chunks": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Chunks",
            "type": "integer"
          },
          "sourceChannels": {
            "enum": [
              1,
              2
            ],
            "title": "Sourcechannels",
            "type": "integer"
          },
          "sourceFrames": {
            "maximum": 1440000.0,
            "minimum": 1.0,
            "title": "Sourceframes",
            "type": "integer"
          },
          "sourceSampleRate": {
            "maximum": 48000.0,
            "minimum": 8000.0,
            "title": "Sourcesamplerate",
            "type": "integer"
          }
        },
        "required": [
          "sourceSampleRate",
          "sourceChannels",
          "sourceFrames",
          "analyzedSampleRate",
          "analyzedFrames",
          "chunks"
        ],
        "title": "AudioSummary",
        "type": "object"
      },
      "CancelledError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "cancelled",
            "title": "Code",
            "type": "string"
          },
          "retryable": {
            "const": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "title": "CancelledError",
        "type": "object"
      },
      "ConflictError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "conflict",
            "title": "Code",
            "type": "string"
          },
          "retryable": {
            "const": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "title": "ConflictError",
        "type": "object"
      },
      "InvalidAudioError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "invalid_audio",
            "title": "Code",
            "type": "string"
          },
          "retryable": {
            "const": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "title": "InvalidAudioError",
        "type": "object"
      },
      "ModelPin": {
        "additionalProperties": false,
        "properties": {
          "modelVersion": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Modelversion",
            "type": "string"
          },
          "providerId": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Providerid",
            "type": "string"
          },
          "taxonomyVersion": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Taxonomyversion",
            "type": "string"
          }
        },
        "required": [
          "providerId",
          "modelVersion",
          "taxonomyVersion"
        ],
        "title": "ModelPin",
        "type": "object"
      },
      "ProviderBlockedError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "provider_blocked",
            "title": "Code",
            "type": "string"
          },
          "retryable": {
            "const": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "title": "ProviderBlockedError",
        "type": "object"
      },
      "ProviderFailureError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "provider_failure",
            "title": "Code",
            "type": "string"
          },
          "retryable": {
            "const": true,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "title": "ProviderFailureError",
        "type": "object"
      },
      "ProviderProvenance": {
        "additionalProperties": false,
        "properties": {
          "inputKind": {
            "enum": [
              "synthetic-fixture",
              "recording"
            ],
            "title": "Inputkind",
            "type": "string"
          },
          "licenseIdentifier": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Licenseidentifier",
            "type": "string"
          },
          "licenseStatus": {
            "enum": [
              "technical-fixture",
              "approved"
            ],
            "title": "Licensestatus",
            "type": "string"
          },
          "modelSha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Modelsha256",
            "type": "string"
          },
          "modelVersion": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Modelversion",
            "type": "string"
          },
          "preprocessingVersion": {
            "const": "pcm16-mono-sinc16k-v1",
            "title": "Preprocessingversion",
            "type": "string"
          },
          "providerId": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Providerid",
            "type": "string"
          },
          "taxonomyVersion": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Taxonomyversion",
            "type": "string"
          }
        },
        "required": [
          "providerId",
          "modelVersion",
          "modelSha256",
          "taxonomyVersion",
          "inputKind",
          "licenseStatus",
          "licenseIdentifier",
          "preprocessingVersion"
        ],
        "title": "ProviderProvenance",
        "type": "object"
      },
      "RawCandidate": {
        "additionalProperties": false,
        "properties": {
          "chunkIndex": {
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Chunkindex",
            "type": "integer"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "endFrame": {
            "maximum": 480000.0,
            "minimum": 1.0,
            "title": "Endframe",
            "type": "integer"
          },
          "providerLabel": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Providerlabel",
            "type": "string"
          },
          "startFrame": {
            "maximum": 479999.0,
            "minimum": 0.0,
            "title": "Startframe",
            "type": "integer"
          }
        },
        "required": [
          "chunkIndex",
          "startFrame",
          "endFrame",
          "providerLabel",
          "confidence"
        ],
        "title": "RawCandidate",
        "type": "object"
      },
      "RecordingRef": {
        "additionalProperties": false,
        "properties": {
          "generation": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Generation",
            "type": "integer"
          },
          "id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Id",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "generation",
          "sha256"
        ],
        "title": "RecordingRef",
        "type": "object"
      },
      "RecordingUnavailableError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "recording_unavailable",
            "title": "Code",
            "type": "string"
          },
          "retryable": {
            "const": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "title": "RecordingUnavailableError",
        "type": "object"
      },
      "ReviewCandidate": {
        "additionalProperties": false,
        "properties": {
          "commonName": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Commonname",
            "type": "string"
          },
          "disposition": {
            "const": "requires-human-review",
            "title": "Disposition",
            "type": "string"
          },
          "rawCandidateIndex": {
            "maximum": 199.0,
            "minimum": 0.0,
            "title": "Rawcandidateindex",
            "type": "integer"
          },
          "scientificName": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Scientificname",
            "type": "string"
          },
          "speciesId": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "title": "Speciesid",
            "type": "string"
          }
        },
        "required": [
          "rawCandidateIndex",
          "speciesId",
          "commonName",
          "scientificName",
          "disposition"
        ],
        "title": "ReviewCandidate",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ChirpNeighbors owner audio API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "title": "Response Health Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/audio/analyze": {
      "post": {
        "operationId": "analyze_v1_audio_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AudioAnalyzeCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "audio.completed": "#/components/schemas/AudioCompletedEvent",
                      "audio.failed": "#/components/schemas/AudioFailedEvent"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AudioCompletedEvent"
                    },
                    {
                      "$ref": "#/components/schemas/AudioFailedEvent"
                    }
                  ],
                  "title": "Response Analyze V1 Audio Analyze Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioHTTPError"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioHTTPError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioHTTPError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioFailedEvent"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioFailedEvent"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioHTTPError"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioHTTPError"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AudioHTTPError"
                    },
                    {
                      "$ref": "#/components/schemas/AudioFailedEvent"
                    }
                  ],
                  "title": "Response 422 Analyze V1 Audio Analyze Post"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AudioHTTPError"
                    },
                    {
                      "$ref": "#/components/schemas/AudioFailedEvent"
                    }
                  ],
                  "title": "Response 503 Analyze V1 Audio Analyze Post"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Analyze"
      }
    }
  }
}
