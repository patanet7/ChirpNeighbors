{
  "$ref": "#/definitions/ShapeReviewV1",
  "definitions": {
    "ShapeReviewV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "basedOn": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "artifactId": {
              "$ref": "#/definitions/ShapeReviewV1/properties/basedOn/properties/jobId"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "jobId",
            "artifactId",
            "version",
            "contentDigest"
          ],
          "additionalProperties": false
        },
        "speciesId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]*$"
        },
        "masterPoseId": {
          "$ref": "#/definitions/ShapeReviewV1/properties/speciesId"
        },
        "poses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "poseId": {
                "$ref": "#/definitions/ShapeReviewV1/properties/speciesId"
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "visualBounds": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 256
                  },
                  "y": {
                    "$ref": "#/definitions/ShapeReviewV1/properties/poses/items/properties/visualBounds/properties/x"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "support": {
                "type": "object",
                "properties": {
                  "x": {
                    "$ref": "#/definitions/ShapeReviewV1/properties/poses/items/properties/visualBounds/properties/x"
                  },
                  "y": {
                    "$ref": "#/definitions/ShapeReviewV1/properties/poses/items/properties/visualBounds/properties/x"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "footprint": {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 128
                  },
                  "right": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 128
                  },
                  "back": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 64
                  },
                  "front": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 64
                  }
                },
                "required": [
                  "left",
                  "right",
                  "back",
                  "front"
                ],
                "additionalProperties": false
              },
              "landmarks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "$ref": "#/definitions/ShapeReviewV1/properties/poses/items/properties/visualBounds/properties/x"
                    },
                    "y": {
                      "$ref": "#/definitions/ShapeReviewV1/properties/poses/items/properties/visualBounds/properties/x"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "head",
                        "body",
                        "beak",
                        "tail",
                        "left-foot",
                        "right-foot"
                      ]
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 6
              }
            },
            "required": [
              "poseId",
              "frame",
              "visualBounds",
              "support",
              "footprint",
              "landmarks"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 576
        }
      },
      "required": [
        "schemaVersion",
        "basedOn",
        "speciesId",
        "masterPoseId",
        "poses"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/shape-review-v1.schema.json",
  "description": "Versioned private image-pipeline structural boundary: legacy render v2, pose render v3 with optional reviewed shape v1, packaging input v2, retained RGBA source v1, and local reference/image stages v1. Actual byte hashes, palette/grid/alpha rules, graph/reference/catalog consistency, supported strategy and review/ownership require runtime admission. Source artifacts can contain private pixel bytes and are not public projections. Structural validation grants no provider execution, species fidelity or review authorization."
}
