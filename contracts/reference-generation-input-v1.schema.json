{
  "$ref": "#/definitions/ReferenceGenerationInputV1",
  "definitions": {
    "ReferenceGenerationInputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "referencePin": {
          "type": "object",
          "properties": {
            "referenceId": {
              "type": "string",
              "format": "uuid"
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reviewDigest": {
              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/referencePin/properties/contentDigest"
            }
          },
          "required": [
            "referenceId",
            "contentDigest",
            "reviewDigest"
          ],
          "additionalProperties": false
        },
        "planningInput": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 2
            },
            "taxonomy": {
              "type": "object",
              "properties": {
                "catalog": {
                  "type": "string",
                  "const": "chirp-display-catalog"
                },
                "version": {
                  "type": "number",
                  "const": 1
                },
                "speciesId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]*$"
                }
              },
              "required": [
                "catalog",
                "version",
                "speciesId"
              ],
              "additionalProperties": false
            },
            "scientificName": {
              "type": "string",
              "minLength": 2,
              "maxLength": 160,
              "allOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[\\u0000-\\uFFFF](?:[\\u0000-\\uFFFF](?:[\\u0000-\\uFFFF]|[^\\u0000-\\uFFFF])|[^\\u0000-\\uFFFF])|[^\\u0000-\\uFFFF](?:[\\u0000-\\uFFFF]|[^\\u0000-\\uFFFF]))"
                }
              ]
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "type": "number",
                    "const": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]*$"
                  },
                  "fixture": {
                    "type": "boolean"
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "local-file",
                          "archive-file",
                          "technical-fixture"
                        ]
                      },
                      "fileIdentity": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "originalUrl": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 2048,
                            "pattern": "^https:\\/\\/[!-~]+(?![\\s\\S])"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "descriptionPageUrl": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/originalUrl/anyOf/0"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "author": {
                        "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                      },
                      "uploader": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "attribution": {
                        "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                      },
                      "description": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sourceTimestamp": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(([0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|(02)-(0[1-9]|1[0-9]|2[0-8])))T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?(Z)(?![\\s\\S])"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "remoteHash": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "algorithm": {
                                "type": "string",
                                "enum": [
                                  "sha1",
                                  "sha256"
                                ]
                              },
                              "value": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
                              }
                            },
                            "required": [
                              "algorithm",
                              "value"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "fileIdentity",
                      "originalUrl",
                      "descriptionPageUrl",
                      "author",
                      "uploader",
                      "attribution",
                      "description",
                      "sourceTimestamp",
                      "remoteHash"
                    ],
                    "additionalProperties": false
                  },
                  "original": {
                    "type": "object",
                    "properties": {
                      "bytes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16777216
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "mime": {
                        "type": "string",
                        "enum": [
                          "image/png",
                          "image/jpeg",
                          "application/x-chirp-rgba8"
                        ]
                      }
                    },
                    "required": [
                      "bytes",
                      "sha256",
                      "mime"
                    ],
                    "additionalProperties": false
                  },
                  "decoded": {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "const": "rgba8-straight"
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 256
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 256
                      },
                      "sha256": {
                        "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/original/properties/sha256"
                      },
                      "decoder": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                          },
                          "version": {
                            "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                          }
                        },
                        "required": [
                          "id",
                          "version"
                        ],
                        "additionalProperties": false
                      },
                      "derivation": {
                        "type": "string",
                        "enum": [
                          "raw-identity",
                          "declared-unverified"
                        ]
                      }
                    },
                    "required": [
                      "format",
                      "width",
                      "height",
                      "sha256",
                      "decoder",
                      "derivation"
                    ],
                    "additionalProperties": false
                  },
                  "rights": {
                    "type": "object",
                    "properties": {
                      "licenseId": {
                        "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                      },
                      "licenseVersion": {
                        "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                      },
                      "licenseUrl": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/originalUrl/anyOf/0"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "approved",
                          "denied",
                          "conflicting"
                        ]
                      },
                      "restrictions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                        },
                        "maxItems": 16
                      },
                      "referenceUseAllowed": {
                        "type": "boolean"
                      },
                      "derivativesAllowed": {
                        "type": "boolean"
                      },
                      "redistributionAllowed": {
                        "type": "boolean"
                      },
                      "generationPermission": {
                        "type": "string",
                        "enum": [
                          "not-reviewed",
                          "allowed",
                          "denied"
                        ]
                      },
                      "review": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "reviewerId": {
                                "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                              },
                              "evidenceId": {
                                "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                              },
                              "reviewedAt": {
                                "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/sourceTimestamp/anyOf/0"
                              }
                            },
                            "required": [
                              "reviewerId",
                              "evidenceId",
                              "reviewedAt"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "licenseId",
                      "licenseVersion",
                      "licenseUrl",
                      "status",
                      "restrictions",
                      "referenceUseAllowed",
                      "derivativesAllowed",
                      "redistributionAllowed",
                      "generationPermission",
                      "review"
                    ],
                    "additionalProperties": false
                  },
                  "taxonomy": {
                    "type": "object",
                    "properties": {
                      "application": {
                        "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/taxonomy"
                      },
                      "declaredScientificName": {
                        "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                      },
                      "aliases": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "authority": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                            },
                            "version": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                            },
                            "taxonId": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                            },
                            "scientificName": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                            }
                          },
                          "required": [
                            "authority",
                            "version",
                            "taxonId",
                            "scientificName"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 16
                      },
                      "externalEvidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "authority": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                            },
                            "version": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                            },
                            "entityId": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/id"
                            },
                            "statement": {
                              "type": "string",
                              "enum": [
                                "scientific-name",
                                "rank",
                                "parent-taxon",
                                "image",
                                "depicts"
                              ]
                            },
                            "value": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                            },
                            "status": {
                              "type": "string",
                              "const": "candidate-evidence"
                            }
                          },
                          "required": [
                            "authority",
                            "version",
                            "entityId",
                            "statement",
                            "value",
                            "status"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 32
                      },
                      "review": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/rights/properties/review/anyOf/0"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "application",
                      "declaredScientificName",
                      "aliases",
                      "externalEvidence",
                      "review"
                    ],
                    "additionalProperties": false
                  },
                  "annotations": {
                    "type": "object",
                    "properties": {
                      "sex": {
                        "type": "string",
                        "enum": [
                          "female",
                          "male",
                          "unknown"
                        ]
                      },
                      "age": {
                        "type": "string",
                        "enum": [
                          "juvenile",
                          "adult",
                          "unknown"
                        ]
                      },
                      "plumage": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/references/items/properties/source/properties/fileIdentity"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "viewpoint": {
                        "type": "string",
                        "enum": [
                          "left",
                          "right",
                          "front",
                          "back",
                          "above",
                          "below",
                          "oblique",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "sex",
                      "age",
                      "plumage",
                      "viewpoint"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "schemaVersion",
                  "id",
                  "fixture",
                  "source",
                  "original",
                  "decoded",
                  "rights",
                  "taxonomy",
                  "annotations"
                ],
                "additionalProperties": false
              },
              "maxItems": 16
            },
            "recipe": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]{0,159}$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            "overrides": {
              "type": "object",
              "properties": {
                "clips": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": [
                          "idle",
                          "moving",
                          "perching",
                          "singing",
                          "feeding",
                          "bathing",
                          "sleeping",
                          "playing",
                          "nesting"
                        ]
                      },
                      "durationTicks": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 300
                      },
                      "loop": {
                        "type": "boolean"
                      },
                      "frames": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "index": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 63
                            },
                            "phase": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]{0,159}$"
                            },
                            "durationTicks": {
                              "$ref": "#/definitions/ReferenceGenerationInputV1/properties/planningInput/properties/overrides/properties/clips/items/properties/durationTicks"
                            },
                            "proposedPivot": {
                              "type": "object",
                              "properties": {
                                "x": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 32
                                },
                                "y": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 32
                                }
                              },
                              "required": [
                                "x",
                                "y"
                              ],
                              "additionalProperties": false
                            },
                            "contactRequirements": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "left-foot",
                                  "right-foot",
                                  "perch",
                                  "ground"
                                ]
                              },
                              "maxItems": 4
                            }
                          },
                          "required": [
                            "index"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1,
                        "maxItems": 64
                      }
                    },
                    "required": [
                      "action"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 9
                }
              },
              "required": [
                "clips"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schemaVersion",
            "taxonomy",
            "scientificName",
            "references",
            "recipe",
            "overrides"
          ],
          "additionalProperties": false
        },
        "provider": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]{0,159}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "referencePin",
        "planningInput",
        "provider"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/reference-generation-input-v1.schema.json",
  "description": "Owner-private immutable image admission and local diagnostic generation structural boundary. Bounded PNG/JPEG byte identities retain decoder normalization and source provenance. Rights, species and explicit pose scopes are separate owner assertions; content-bound review pins require exact live ownership, byte hashes, current permissions and terminal revocation checks. Retained discovery snapshots cannot be relabeled by review. Source/refinement semantics enforce allocation, source correspondence, review chronology and diagnostic pixel constraints. Unknown adapter pins require runtime registry rejection. Diagnostic candidates are fixture-only, generated false and nonrenderable; they do not certify legal rights, species fidelity, real generation, renderer admission or public release. No arbitrary URL fetch, model call, paid service or external upload is authorized."
}
