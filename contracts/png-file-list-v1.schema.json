{
  "$ref": "#/definitions/PngFileListV1",
  "definitions": {
    "PngFileListV1": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "type": "number",
                    "const": 1
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "original": {
                    "type": "object",
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 524288
                      }
                    },
                    "required": [
                      "sha256",
                      "bytes"
                    ],
                    "additionalProperties": false
                  },
                  "canonical": {
                    "type": "object",
                    "properties": {
                      "sha256": {
                        "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/file/properties/original/properties/sha256"
                      },
                      "bytes": {
                        "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/file/properties/original/properties/bytes"
                      },
                      "rgbaSha256": {
                        "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/file/properties/original/properties/sha256"
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1024
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1024
                      }
                    },
                    "required": [
                      "sha256",
                      "bytes",
                      "rgbaSha256",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  "decoder": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "const": "sharp"
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "libvips": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "id",
                      "version",
                      "libvips"
                    ],
                    "additionalProperties": false
                  },
                  "normalization": {
                    "type": "string",
                    "const": "chirp-png-straight-srgb8-hidden-rgb-zero-v1"
                  }
                },
                "required": [
                  "schemaVersion",
                  "id",
                  "original",
                  "canonical",
                  "decoder",
                  "normalization"
                ],
                "additionalProperties": false
              },
              "createdAt": {
                "type": "string",
                "pattern": "^(([0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|(02)-(0[1-9]|1[0-9]|2[0-8])))T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?(Z)(?![\\s\\S])"
              },
              "review": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "requestId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "decision": {
                        "type": "string",
                        "enum": [
                          "approved",
                          "rejected"
                        ]
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "schemaVersion": {
                            "type": "number",
                            "const": 1
                          },
                          "speciesId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]*$"
                          },
                          "representation": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "source": {
                            "type": "string",
                            "enum": [
                              "deterministic_fixture",
                              "user_upload",
                              "provider"
                            ]
                          },
                          "creator": {
                            "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/review/anyOf/0/properties/source/properties/speciesId"
                          },
                          "sourceVersion": {
                            "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/review/anyOf/0/properties/source/properties/speciesId"
                          },
                          "license": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/review/anyOf/0/properties/source/properties/representation"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "development-only",
                                  "cleared",
                                  "pending",
                                  "denied"
                                ]
                              },
                              "derivativesAllowed": {
                                "type": "boolean"
                              },
                              "redistributionAllowed": {
                                "type": "boolean"
                              },
                              "evidenceId": {
                                "anyOf": [
                                  {
                                    "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/review/anyOf/0/properties/source/properties/speciesId"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "attribution": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 300
                              }
                            },
                            "required": [
                              "id",
                              "status",
                              "derivativesAllowed",
                              "redistributionAllowed",
                              "evidenceId",
                              "attribution"
                            ],
                            "additionalProperties": false
                          },
                          "references": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/review/anyOf/0/properties/source/properties/speciesId"
                                },
                                "speciesId": {
                                  "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/review/anyOf/0/properties/source/properties/speciesId"
                                },
                                "contentDigest": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{64}$"
                                },
                                "role": {
                                  "type": "string",
                                  "enum": [
                                    "technical-fixture",
                                    "species-reference"
                                  ]
                                }
                              },
                              "required": [
                                "id",
                                "speciesId",
                                "contentDigest",
                                "role"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 1,
                            "maxItems": 16
                          },
                          "fidelityReview": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "reviewerId": {
                                    "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/review/anyOf/0/properties/source/properties/speciesId"
                                  },
                                  "reviewedAt": {
                                    "type": "string",
                                    "pattern": "^(([0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|(02)-(0[1-9]|1[0-9]|2[0-8])))T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?(Z)(?![\\s\\S])"
                                  },
                                  "evidenceId": {
                                    "$ref": "#/definitions/PngFileListV1/properties/files/items/properties/review/anyOf/0/properties/source/properties/speciesId"
                                  }
                                },
                                "required": [
                                  "reviewerId",
                                  "reviewedAt",
                                  "evidenceId"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "schemaVersion",
                          "speciesId",
                          "representation",
                          "source",
                          "creator",
                          "sourceVersion",
                          "license",
                          "references",
                          "fidelityReview"
                        ],
                        "additionalProperties": false
                      },
                      "reviewedAt": {
                        "type": "string",
                        "pattern": "^(([0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|(02)-(0[1-9]|1[0-9]|2[0-8])))T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?(Z)(?![\\s\\S])"
                      }
                    },
                    "required": [
                      "requestId",
                      "decision",
                      "source",
                      "reviewedAt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "file",
              "createdAt",
              "review"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/png-file-list-v1.schema.json",
  "description": "Private local PNG structural boundary. Real binary PNG upload is bounded before decoding. File ownership, immutable original/canonical/RGBA hashes, exact atlas extraction, rights review, reference validation and explicit source/manifest review require server authority. A file, schema or fixture never grants derivative rights, species fidelity, provider execution or public release. No paths or remote fetching."
}
