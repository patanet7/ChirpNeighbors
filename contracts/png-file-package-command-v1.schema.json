{
  "$ref": "#/definitions/PngFilePackageCommandV1",
  "definitions": {
    "PngFilePackageCommandV1": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "layout": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "width",
            "height",
            "columns",
            "rows"
          ],
          "additionalProperties": false
        },
        "logicalPixelSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "paletteLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "clips": {
          "type": "object",
          "properties": {
            "idle": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "moving",
                    "perching",
                    "singing",
                    "feeding",
                    "bathing",
                    "sleeping",
                    "playing",
                    "nesting"
                  ]
                },
                "direction": {
                  "type": "string",
                  "const": "right-facing-mirrorable"
                },
                "loop": {
                  "type": "boolean"
                },
                "poses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "frame": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 63
                      },
                      "durationTicks": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 300
                      },
                      "pivot": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 256
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 256
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "contacts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle/properties/poses/items/properties/pivot/properties/x"
                            },
                            "y": {
                              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle/properties/poses/items/properties/pivot/properties/y"
                            },
                            "kind": {
                              "type": "string",
                              "enum": [
                                "left-foot",
                                "right-foot",
                                "perch",
                                "ground"
                              ]
                            }
                          },
                          "required": [
                            "x",
                            "y",
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 4
                      },
                      "poseId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]*$"
                      },
                      "rotation": {
                        "type": "number",
                        "minimum": -0.5,
                        "maximum": 0.5
                      }
                    },
                    "required": [
                      "frame",
                      "durationTicks",
                      "pivot",
                      "contacts",
                      "poseId",
                      "rotation"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 256
                }
              },
              "required": [
                "action",
                "direction",
                "loop",
                "poses"
              ],
              "additionalProperties": false
            },
            "moving": {
              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle"
            },
            "perching": {
              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle"
            },
            "singing": {
              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle"
            },
            "feeding": {
              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle"
            },
            "bathing": {
              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle"
            },
            "sleeping": {
              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle"
            },
            "playing": {
              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle"
            },
            "nesting": {
              "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle"
            }
          },
          "required": [
            "idle"
          ],
          "additionalProperties": false
        },
        "conditioning": {
          "type": "object",
          "properties": {
            "taxonomy": {
              "type": "object",
              "properties": {
                "catalog": {
                  "type": "string",
                  "const": "chirp-display-catalog"
                },
                "version": {
                  "type": "number",
                  "const": 1
                },
                "speciesId": {
                  "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                }
              },
              "required": [
                "catalog",
                "version",
                "speciesId"
              ],
              "additionalProperties": false
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "species",
                        "style",
                        "pose"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 3
                  },
                  "pin": {
                    "type": "object",
                    "properties": {
                      "jobId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "artifactId": {
                        "$ref": "#/definitions/PngFilePackageCommandV1/properties/conditioning/properties/references/items/properties/pin/properties/jobId"
                      },
                      "version": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "contentDigest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "jobId",
                      "artifactId",
                      "version",
                      "contentDigest"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "roles",
                  "pin"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 16
            },
            "poseGraph": {
              "type": "object",
              "properties": {
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                      },
                      "frame": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 63
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "idle",
                          "moving",
                          "perching",
                          "singing",
                          "feeding",
                          "bathing",
                          "sleeping",
                          "playing",
                          "nesting"
                        ]
                      },
                      "referenceId": {
                        "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                      }
                    },
                    "required": [
                      "id",
                      "frame",
                      "action",
                      "referenceId"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 576
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                      },
                      "to": {
                        "$ref": "#/definitions/PngFilePackageCommandV1/properties/clips/properties/idle/properties/poses/items/properties/poseId"
                      }
                    },
                    "required": [
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 2304
                }
              },
              "required": [
                "nodes",
                "edges"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "taxonomy",
            "references",
            "poseGraph"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "requestId",
        "layout",
        "logicalPixelSize",
        "paletteLimit",
        "clips",
        "conditioning"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chirpneighbors.local/contracts/png-file-package-command-v1.schema.json",
  "description": "Private local PNG structural boundary. Real binary PNG upload is bounded before decoding. File ownership, immutable original/canonical/RGBA hashes, exact atlas extraction, rights review, reference validation and explicit source/manifest review require server authority. A file, schema or fixture never grants derivative rights, species fidelity, provider execution or public release. No paths or remote fetching."
}
